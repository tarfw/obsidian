---
const capabilities = [
  {
    title: "WhatsApp & Telegram",
    desc: "Message customers on the apps they already use."
  },
  {
    title: "Voice Notes",
    desc: "Speak in Tamil, English, or 40+ languages — it becomes a record."
  },
  {
    title: "Zero Per-Seat Fees",
    desc: "Add your whole team for ₹0."
  },
  {
    title: "Works Offline",
    desc: "Orders, inventory, and sales keep working without internet."
  },
  {
    title: "Team Feed",
    desc: "One inbox for chats, alerts, and approvals."
  },
  {
    title: "Automated Reminders",
    desc: "Reminders, confirmations, and dispatch notices — sent automatically."
  },
  {
    title: "1-Tap Takeover",
    desc: "Step in and reply to any conversation instantly."
  },
  {
    title: "Data Ownership",
    desc: "Your records stay yours. Export them anytime."
  }
];
---

<section class="capabilities-section pastel-room-sage" id="capabilities">
  <div class="container">

    <div class="section-head-left">
      <h2 class="display-section-lg section-title">
        Capabilities built<br />
        for everyday operations.
      </h2>
    </div>

    <div class="capabilities-grid font-dm-sans">
      {capabilities.map((c) => (
        <div class="cap-item">
          <h3 class="cap-title">{c.title}</h3>
          <p class="cap-desc">{c.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .capabilities-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .section-head-left {
    max-width: 720px;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .section-lead {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-graphite);
    margin: 0;
  }

  /* 8-Item Clean Grid with Subtle Dividers */
  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 600px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .capabilities-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cap-item {
    padding: 20px 18px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (min-width: 600px) {
    .cap-item:nth-child(odd) {
      border-right: 1px solid rgba(0, 0, 0, 0.08);
    }
  }

  @media (min-width: 1024px) {
    .cap-item:nth-child(odd) {
      border-right: none;
    }
    .cap-item {
      border-right: 1px solid rgba(0, 0, 0, 0.08);
    }
    .cap-item:nth-child(4n) {
      border-right: none;
    }
  }

  .cap-title {
    font-size: 15.5px;
    font-weight: 700;
    color: var(--color-canopy-green);
    margin: 0;
  }

  .cap-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-graphite);
    margin: 0;
  }
</style>
