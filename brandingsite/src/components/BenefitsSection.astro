---
// Eight Core Capabilities — Simple, Compact & Direct 4x2 Grid
const capabilities = [
  {
    title: "Official WhatsApp & Telegram",
    desc: "Direct verified integrations with interactive buttons, menus, and delivery receipts."
  },
  {
    title: "Voice Notes in 40+ Languages",
    desc: "Speak naturally in Tamil, English, and 40+ languages. Whisper transcribes audio into records."
  },
  {
    title: "Zero Per-Seat Fees",
    desc: "Add your entire team of staff, cashiers, or volunteers with ₹0 per-user subscription fees."
  },
  {
    title: "Works 100% Offline",
    desc: "Take orders, check inventory, and manage sales on device without internet connectivity."
  },
  {
    title: "Unified Team Feed",
    desc: "One calm inbox for customer chats, urgent alerts, and internal staff approvals."
  },
  {
    title: "Automated Care Loops",
    desc: "Send appointment reminders, confirmations, and dispatch notices automatically."
  },
  {
    title: "1-Tap Human Takeover",
    desc: "Step in and reply to any customer conversation instantly with a single tap."
  },
  {
    title: "Complete Data Ownership",
    desc: "Your records belong solely to you with instant full data export and zero lock-in."
  }
];
---

<section class="capabilities-section pastel-room-sage" id="capabilities">
  <div class="container">
    
    <!-- Section Header -->
    <div class="section-head-left">
      <h2 class="display-section-lg section-title">
        Eight capabilities built<br />
        for everyday operations.
      </h2>
      <p class="section-lead font-dm-sans">
        Everything clinics, retail stores, and field teams need to run communications reliably.
      </p>
    </div>

    <!-- 8 Capabilities Compact Grid -->
    <div class="capabilities-grid font-dm-sans">
      {capabilities.map((c, idx) => (
        <div class="cap-item">
          <span class="cap-index">{String(idx + 1).padStart(2, '0')}</span>
          <h3 class="cap-title">{c.title}</h3>
          <p class="cap-desc">{c.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .capabilities-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .section-head-left {
    max-width: 720px;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .section-lead {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-graphite);
    margin: 0;
  }

  /* 8-Item Clean Grid with Subtle Dividers */
  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 600px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .capabilities-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cap-item {
    padding: 20px 18px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (min-width: 600px) {
    .cap-item:nth-child(odd) {
      border-right: 1px solid rgba(0, 0, 0, 0.08);
    }
  }

  @media (min-width: 1024px) {
    .cap-item:nth-child(odd) {
      border-right: none;
    }
    .cap-item {
      border-right: 1px solid rgba(0, 0, 0, 0.08);
    }
    .cap-item:nth-child(4n) {
      border-right: none;
    }
  }

  .cap-index {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-slate);
    letter-spacing: 0.05em;
  }

  .cap-title {
    font-size: 15.5px;
    font-weight: 700;
    color: var(--color-canopy-green);
    margin: 0;
  }

  .cap-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-graphite);
    margin: 0;
  }
</style>
