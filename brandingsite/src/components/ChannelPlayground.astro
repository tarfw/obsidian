---
// Run Your Teams on Channels — Simple, Compact & Direct
const teamCapabilities = [
  {
    badge: "TEAM INBOX",
    title: "Shared Team Feed (₹0)",
    desc: "Invite unlimited cashiers, drivers, and staff. Everyone collaborates in one calm feed."
  },
  {
    badge: "WORKFLOWS",
    title: "1-Tap In-Chat Approvals",
    desc: "Approve supply orders, schedule changes, and bills directly from WhatsApp or Telegram."
  },
  {
    badge: "VOICE NOTES",
    title: "Voice Notes to Records",
    desc: "Send audio notes in any language. Whisper transcribes them into orders and ledgers instantly."
  }
];
---

<section class="teams-channel-section pastel-room-sky" id="genui">
  <div class="container">
    
    <div class="editorial-split-grid">
      
      <!-- Left Column: Headline & Team Capabilities -->
      <div class="teams-narrative-col">
        <h2 class="display-section-lg section-title">
          Run your teams<br />
          <span class="text-canopy">on everyday channels.</span>
        </h2>

        <p class="section-lead font-dm-sans">
          One shared inbox with zero per-seat software fees. Connect frontline workers, staff, and customers on the messaging apps they already use.
        </p>

        <div class="team-caps-list font-dm-sans">
          {teamCapabilities.map((cap) => (
            <div class="cap-row">
              <div class="cap-tag-col">
                <span class="cap-badge">{cap.badge}</span>
              </div>
              <div class="cap-desc-col">
                <h3 class="cap-title">{cap.title}</h3>
                <p class="cap-desc">{cap.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Clean Dark Window Mockup -->
      <div class="teams-visual-col">
        <div class="dark-window-frame font-dm-sans">
          
          <!-- macOS Window Controls -->
          <div class="window-controls-bar">
            <span class="window-dot"></span>
            <span class="window-dot"></span>
            <span class="window-dot"></span>
          </div>

          <!-- 3 Compact Team Operation Message Cards -->
          <div class="whatsapp-cards-stack">
            
            <!-- Message 1: Roster & Shift Approval -->
            <div class="wa-bubble-card">
              <div class="wa-bubble-main">
                <p class="wa-msg-text">
                  Dr. Ponni approved shift swap with Dr. Meenakshi for Friday clinic. 14 patient visits re-assigned.
                </p>
                <span class="wa-timestamp">11:20 AM</span>
              </div>
              <button class="wa-action-bar-btn font-dm-sans">
                <span class="wa-btn-icon">✓</span>
                <span>View Updated Roster</span>
              </button>
            </div>

            <!-- Message 2: Logistics Voice Note & Receipt Scan -->
            <div class="wa-bubble-card">
              <div class="wa-bubble-main">
                <p class="wa-msg-text">
                  🎙️ Audio from Logistics: "Delivered 30 boxes to Central Ward. Invoice #902 receipt scanned and synced offline."
                </p>
                <span class="wa-timestamp">11:24 AM</span>
              </div>
            </div>

            <!-- Message 3: Team Broadcast Confirmation -->
            <div class="wa-bubble-card">
              <div class="wa-bubble-main">
                <p class="wa-msg-text">
                  Weather alert broadcasted to 18 staff members on Telegram & WhatsApp. 18 confirmed read.
                </p>
                <span class="wa-timestamp">11:25 AM</span>
              </div>
              <button class="wa-action-bar-btn font-dm-sans">
                <span class="wa-btn-icon">↗</span>
                <span>Open Team Feed</span>
              </button>
            </div>

          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .teams-channel-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .editorial-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .editorial-split-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 48px;
    }
  }

  .teams-narrative-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 520px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .text-canopy {
    color: var(--color-canopy-green);
  }

  .section-lead {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-graphite);
    margin: 0;
  }

  .team-caps-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    margin-top: 8px;
  }

  .cap-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 540px) {
    .cap-row {
      grid-template-columns: 100px 1fr;
      gap: 14px;
    }
  }

  .cap-tag-col {
    display: flex;
    flex-direction: column;
  }

  .cap-badge {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--color-canopy-green);
    letter-spacing: 0.06em;
  }

  .cap-desc-col {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cap-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-canopy-green);
    margin: 0;
  }

  .cap-desc {
    font-size: 13px;
    color: var(--color-graphite);
    line-height: 1.45;
    margin: 0;
  }

  /* Right Visual */
  .teams-visual-col {
    display: flex;
    justify-content: center;
  }

  .dark-window-frame {
    width: 100%;
    max-width: 320px;
    background-color: #232724;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 12px 14px 16px 14px;
    display: flex;
    flex-direction: column;
  }

  .window-controls-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 10px;
  }

  .window-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #525854;
  }

  .whatsapp-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .wa-bubble-card {
    background-color: #2b302c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    color: #e9edef;
  }

  .wa-bubble-main {
    padding: 10px 12px 6px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .wa-msg-text {
    font-size: 12.5px;
    line-height: 1.4;
    color: #f1f3f4;
    margin: 0;
  }

  .wa-timestamp {
    align-self: flex-end;
    font-size: 9.5px;
    color: #8e9590;
    line-height: 1;
    margin-top: 2px;
  }

  .wa-action-bar-btn {
    width: 100%;
    background: transparent;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 7px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: #22c55e;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
  }

  .wa-btn-icon {
    font-size: 12px;
  }
</style>
