---
// Run Your Teams on Channels — Following Hero Section Design & Aesthetic (Room Sky #ccf0f8)
const teamCapabilities = [
  {
    badge: "TEAM INBOX",
    title: "One unified inbox with zero seat fees.",
    desc: "Invite your entire team, doctors, volunteers, and cashiers for ₹0. Everyone sees assigned conversations, internal notes, and live customer statuses."
  },
  {
    badge: "WORKFLOWS",
    title: "One-tap approvals inside chat.",
    desc: "Approve supply requests, confirm patient reschedules, and review invoices directly from WhatsApp or Telegram without opening clunky portals."
  },
  {
    badge: "FIELD AUDIO",
    title: "Voice notes transcribed instantly.",
    desc: "On-the-ground staff can speak audio updates in their mother tongue. TAR transcribes the note into structured records and notifies the team."
  }
];
---

<section class="teams-channel-section pastel-room-sky reveal-item" id="genui">
  <div class="container">
    
    <div class="editorial-split-grid">
      
      <!-- Left Column: Headline & Team Capabilities -->
      <div class="teams-narrative-col">
        <h2 class="display-section-lg section-title">
          Run your Teams<br />
          <span class="text-canopy">on Everyday Channels.</span>
        </h2>

        <p class="section-lead font-dm-sans">
          Eliminate expensive software seat taxes and complicated training. Connect your frontline workers, coordinators, and management on the channels they already use every day.
        </p>

        <div class="team-caps-list font-dm-sans">
          {teamCapabilities.map((cap) => (
            <div class="cap-row">
              <div class="cap-tag-col">
                <span class="cap-badge">{cap.badge}</span>
              </div>
              <div class="cap-desc-col">
                <h3 class="cap-title">{cap.title}</h3>
                <p class="cap-desc">{cap.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Dark Window Mockup matching Hero Design Pattern -->
      <div class="teams-visual-col">
        <div class="dark-window-frame font-dm-sans">
          
          <!-- macOS Window Controls Top-Left -->
          <div class="window-controls-bar">
            <span class="window-dot"></span>
            <span class="window-dot"></span>
            <span class="window-dot"></span>
          </div>

          <!-- 3 Centered Team Operation Message Cards -->
          <div class="whatsapp-cards-stack">
            
            <!-- Message 1: Roster & Shift Approval -->
            <div class="wa-bubble-card">
              <div class="wa-bubble-main">
                <p class="wa-msg-text">
                  Dr. Rao approved shift swap with Dr. Kumar for Friday clinic. 14 patient appointments re-assigned.
                </p>
                <span class="wa-timestamp">11:20 AM</span>
              </div>
              <button class="wa-action-bar-btn font-dm-sans">
                <span class="wa-btn-icon">✓</span>
                <span>View Updated Roster</span>
              </button>
            </div>

            <!-- Message 2: Logistics Voice Note & Receipt Scan -->
            <div class="wa-bubble-card">
              <div class="wa-bubble-main">
                <p class="wa-msg-text">
                  🎙️ Audio from Logistics: <em>"Delivered 30 boxes to Central Ward. Invoice #902 receipt scanned and synced offline."</em>
                </p>
                <span class="wa-timestamp">11:24 AM</span>
              </div>
            </div>

            <!-- Message 3: Team Broadcast Confirmation -->
            <div class="wa-bubble-card">
              <div class="wa-bubble-main">
                <p class="wa-msg-text">
                  Weather alert broadcasted to 18 staff members on Telegram & WhatsApp. 18 confirmed read.
                </p>
                <span class="wa-timestamp">11:25 AM</span>
              </div>
              <button class="wa-action-bar-btn font-dm-sans">
                <span class="wa-btn-icon">↗</span>
                <span>Open Team Feed</span>
              </button>
            </div>

          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .teams-channel-section {
    padding: var(--section-gap) 0;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .editorial-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .editorial-split-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 56px;
    }
  }

  .teams-narrative-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .text-canopy {
    color: var(--color-canopy-green);
  }

  .section-lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-graphite);
    max-width: 580px;
  }

  .team-caps-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    margin-top: 12px;
  }

  .cap-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  @media (min-width: 540px) {
    .cap-row {
      grid-template-columns: 110px 1fr;
      gap: 16px;
    }
  }

  .cap-tag-col {
    display: flex;
    flex-direction: column;
  }

  .cap-badge {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-canopy-green);
    letter-spacing: 0.06em;
  }

  .cap-desc-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cap-title {
    font-size: 15.5px;
    font-weight: 700;
    color: var(--color-canopy-green);
  }

  .cap-desc {
    font-size: 13.5px;
    color: var(--color-graphite);
    line-height: 1.5;
  }

  /* Right Visual: Dark Window Mockup matching Hero Design Pattern */
  .teams-visual-col {
    display: flex;
    justify-content: center;
  }

  .dark-window-frame {
    width: 100%;
    max-width: 410px;
    background-color: #232724;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.35);
    padding: 14px 16px 20px 16px;
    display: flex;
    flex-direction: column;
  }

  .window-controls-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 12px;
  }

  .window-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #525854;
  }

  /* 3 Centered WhatsApp Dark Mode Message Cards */
  .whatsapp-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .wa-bubble-card {
    background-color: #2b302c;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    overflow: hidden;
    color: #e9edef;
  }

  .wa-bubble-main {
    padding: 12px 14px 8px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .wa-msg-text {
    font-size: 13px;
    line-height: 1.4;
    color: #f1f3f4;
    margin: 0;
  }

  .wa-timestamp {
    align-self: flex-end;
    font-size: 10px;
    color: #8e9590;
    line-height: 1;
    margin-top: 2px;
  }

  .wa-action-bar-btn {
    width: 100%;
    background: transparent;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 8px 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: #22c55e;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .wa-action-bar-btn:hover {
    background-color: rgba(34, 197, 94, 0.08);
  }

  .wa-btn-icon {
    font-size: 13px;
  }
</style>
