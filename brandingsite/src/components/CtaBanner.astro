---
// Pre-Footer Call to Action — Elegant, Compact & Reflecting TAR
import GooglePlayBadge from "./GooglePlayBadge.astro";
import TarLogo from "./TarLogo.astro";
---

<section class="cta-editorial-section room-canopy-green">
  <div class="container cta-editorial-inner font-dm-sans">
    
    <!-- Brand Lockup -->
    <div class="cta-brand-lockup">
      <TarLogo size={24} color="#55dd4a" />
      <span class="cta-brand-name">tar.</span>
    </div>

    <!-- Main Editorial Headline -->
    <h2 class="display-section-lg cta-heading">
      Start connecting your<br />
      operations today.
    </h2>

    <p class="cta-narrative">
      Calm, honest software built for everyday commerce. Available on Android with zero per-seat software taxes.
    </p>

    <!-- App Store Action -->
    <div class="cta-actions">
      <GooglePlayBadge height={44} />
    </div>

  </div>
</section>

<style>
  .cta-editorial-section {
    background-color: var(--color-canopy-green);
    color: var(--color-paper-white);
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cta-editorial-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .cta-brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 6px 16px;
    border-radius: 9999px;
  }

  .cta-brand-name {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .cta-heading {
    color: #ffffff;
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .cta-narrative {
    font-size: 16px;
    color: var(--color-mint-wash);
    line-height: 1.55;
    max-width: 520px;
    margin: 0;
  }

  .cta-actions {
    margin-top: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
