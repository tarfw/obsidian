---
// Plain-English FAQ Section — Compact & Uncluttered
const faqs = [
  {
    q: "How does TAR's pricing work?",
    a: "The Base Pack is ₹0 (Free forever) for local offline operations. The Work Pack is ₹500/month, which includes encrypted cloud sync, WhatsApp messaging, and ₹100 in preloaded monthly usage credits. Additional on-demand top-ups start from ₹100 with zero expiration."
  },
  {
    q: "Do I have to pay extra for team members, cashiers, or doctors?",
    a: "No. Invited team members are ₹0 (Free). Add your entire team, receptionists, nurses, and drivers without paying per-seat monthly license fees. AI operations run from the owner's central credit wallet."
  },
  {
    q: "Does TAR work offline when the internet goes down?",
    a: "Yes. TAR is built to work offline. You can ring up sales, check product stock, record orders, and check schedules without internet. All updates sync securely as soon as you reconnect."
  },
  {
    q: "Can my customers send voice notes in regional languages?",
    a: "Yes. Customers and staff can send voice notes in 40+ languages (Tamil, Telugu, Spanish, Arabic, English, etc.). Whisper transcribes the audio into structured records and replies with natural text or voice."
  },
  {
    q: "Can human staff take over a chat anytime?",
    a: "Yes, immediately. Staff monitor incoming messages in the unified team feed and can pause automated AI replies to take over conversations with a single tap."
  },
  {
    q: "Do my customers need to install an app?",
    a: "No. Your customers communicate directly inside WhatsApp, Telegram, or standard SMS. They never have to download or learn any new software."
  }
];
---

<section class="faq-editorial-section pastel-room-lilac" id="faq">
  <div class="container">
    
    <div class="section-head-left">
      <h2 class="display-section-lg section-title">
        Frequently asked questions.
      </h2>
      <p class="section-lead font-dm-sans">
        Everything you need to know about TAR, credit pricing, and offline sync.
      </p>
    </div>

    <!-- Accordion List with Clean Horizontal Borders -->
    <div class="faq-accordion-container font-dm-sans">
      {faqs.map((item, idx) => (
        <div class="faq-item-row" data-faq-index={idx}>
          <button class="faq-item-toggle font-dm-sans" aria-expanded="false">
            <span class="faq-question-txt">{item.q}</span>
            <span class="faq-icon-indicator font-dm-sans">+</span>
          </button>
          <div class="faq-item-body font-dm-sans">
            <p class="faq-answer-txt">{item.a}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const initFaq = () => {
    const items = document.querySelectorAll('.faq-item-row');
    items.forEach(item => {
      const btn = item.querySelector('.faq-item-toggle');
      if (!btn) return;

      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        items.forEach(i => {
          i.classList.remove('open');
          const b = i.querySelector('.faq-item-toggle');
          if (b) b.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaq);
  } else {
    initFaq();
  }
</script>

<style>
  .faq-editorial-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .section-head-left {
    max-width: 800px;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
  }

  .section-lead {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-graphite);
  }

  .faq-accordion-container {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .faq-item-row {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    transition: background-color 0.15s ease;
  }

  .faq-item-row:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .faq-item-toggle {
    width: 100%;
    padding: 16px 0;
    background: transparent;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    cursor: pointer;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--color-canopy-green);
    gap: 16px;
  }

  .faq-icon-indicator {
    font-size: 20px;
    color: var(--color-slate);
    transition: transform 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item-row.open .faq-icon-indicator {
    transform: rotate(45deg);
    color: var(--color-canopy-green);
  }

  .faq-item-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease, padding 0.25s ease;
    padding: 0;
  }

  .faq-item-row.open .faq-item-body {
    max-height: 200px;
    padding-bottom: 16px;
  }

  .faq-answer-txt {
    font-size: 14px;
    color: var(--color-graphite);
    line-height: 1.6;
    margin: 0;
  }
</style>
