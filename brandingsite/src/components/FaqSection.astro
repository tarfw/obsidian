---
// Plain-English FAQ Section grounded in TAR Architecture & Pricing
const faqs = [
  {
    q: "How does TAR's credit pricing work?",
    a: "Base activation is ₹500, which includes ₹400 onboarding and ₹100 in pre-loaded wallet credits (1,000 credits). Each active owned workspace costs 100 credits/month (₹10.00/mo). Top-ups are available on demand (₹100 = 1,000 credits) with 100% direct at-cost pass-through and zero expiration."
  },
  {
    q: "Do I have to pay extra for team members, cashiers, or doctors?",
    a: "No, never. Joined team members use ₹0. You can invite your entire staff, clinic receptionists, drivers, and partners without paying extra per-seat monthly license fees. All automated actions run from the workspace owner's wallet."
  },
  {
    q: "Does TAR work offline when the internet goes down?",
    a: "Yes. TAR is built on local on-device SQLite sync. You can continue taking orders, checking patient schedules, and viewing catalogs offline. Changes sync securely with the cloud database as soon as connectivity returns."
  },
  {
    q: "Can my customers send voice notes in regional languages?",
    a: "Yes. Customers can send spoken voice notes in over 40 languages (including Hindi, Tamil, Telugu, Spanish, Arabic, and English). TAR transcribes the audio into structured records and replies with natural text or voice."
  },
  {
    q: "Can human staff take over a chat anytime?",
    a: "Yes, immediately. You have a unified team inbox where staff can monitor incoming messages, answer questions, or seamlessly take over from the automated assistant with one tap."
  },
  {
    q: "Do my customers or patients need to install an app?",
    a: "No. Your customers communicate directly inside WhatsApp, Telegram, or standard SMS. They never have to download or learn any new application."
  }
];
---

<section class="faq-editorial-section pastel-room-lilac reveal-item" id="faq">
  <div class="container">
    
    <div class="section-head-left">
      <h2 class="display-section-lg section-title">
        Frequently asked questions.
      </h2>
      <p class="section-lead font-dm-sans">
        Everything you need to know about TAR, credit pricing, and offline sync.
      </p>
    </div>

    <!-- Accordion List with Clean Horizontal Borders -->
    <div class="faq-accordion-container font-dm-sans">
      {faqs.map((item, idx) => (
        <div class="faq-item-row" data-faq-index={idx}>
          <button class="faq-item-toggle font-dm-sans" aria-expanded="false">
            <span class="faq-question-txt">{item.q}</span>
            <span class="faq-icon-indicator font-dm-sans">+</span>
          </button>
          <div class="faq-item-body font-dm-sans">
            <p class="faq-answer-txt">{item.a}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const initFaq = () => {
    const items = document.querySelectorAll('.faq-item-row');
    items.forEach(item => {
      const btn = item.querySelector('.faq-item-toggle');
      if (!btn) return;

      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        items.forEach(i => {
          i.classList.remove('open');
          const b = i.querySelector('.faq-item-toggle');
          if (b) b.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaq);
  } else {
    initFaq();
  }
</script>

<style>
  .faq-editorial-section {
    padding: var(--section-gap) 0;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .section-head-left {
    max-width: 800px;
    margin-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .section-lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-graphite);
  }

  .faq-accordion-container {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .faq-item-row {
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    transition: background-color 0.15s ease;
  }

  .faq-item-row:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .faq-item-toggle {
    width: 100%;
    padding: 22px 0;
    background: transparent;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    cursor: pointer;
    font-size: 16.5px;
    font-weight: 600;
    color: var(--color-canopy-green);
    gap: 16px;
  }

  .faq-icon-indicator {
    font-size: 22px;
    color: var(--color-slate);
    transition: transform 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item-row.open .faq-icon-indicator {
    transform: rotate(45deg);
    color: var(--color-coral-pulse);
  }

  .faq-item-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), padding 0.3s ease;
    padding: 0;
  }

  .faq-item-row.open .faq-item-body {
    max-height: 200px;
    padding-bottom: 22px;
  }

  .faq-answer-txt {
    font-size: 14.5px;
    color: var(--color-graphite);
    line-height: 1.65;
  }
</style>
