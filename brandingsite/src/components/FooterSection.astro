---
// Clean, Human Directory Footer in Turn.io Canopy Green (#0a3922) with Official Google Play Badge
import GooglePlayBadge from "./GooglePlayBadge.astro";

const channelLinks = [
  { name: "WhatsApp Messaging", href: "#overview" },
  { name: "Telegram Bot Channels", href: "#overview" },
  { name: "Websites & Web Ordering", href: "#overview" },
  { name: "Voice Notes in 40+ Languages", href: "#overview" }
];

const capabilityLinks = [
  { name: "Offline SQLite Sync", href: "#capabilities" },
  { name: "Unified Team Inbox", href: "#genui" },
  { name: "Automated Care Loops", href: "#capabilities" },
  { name: "Zero Per-Seat Taxes", href: "#pricing" }
];

const resourceLinks = [
  { name: "How It Works", href: "#setup" },
  { name: "Teams on Channels", href: "#genui" },
  { name: "Transparent Pricing", href: "#pricing" },
  { name: "Frequently Asked Questions", href: "#faq" }
];

const companyLinks = [
  { name: "About TAR", href: "#" },
  { name: "Google Play Store", href: "https://play.google.com/store/apps" },
  { name: "Privacy Policy", href: "#" },
  { name: "Terms of Service", href: "#" }
];
---

<footer class="footer-section room-canopy-green">
  <div class="container">
    
    <!-- Top Footer Banner -->
    <div class="footer-top-cluster">
      <div class="footer-cta-left">
        <h2 class="display-section footer-headline">
          Helpful messaging for everyone.
        </h2>
        <p class="footer-sublead font-dm-sans">
          Connect with your patients, customers, and community on the messaging apps they already trust.
        </p>
      </div>

      <div class="footer-cta-right">
        <GooglePlayBadge height={42} />
      </div>
    </div>

    <!-- Navigation Columns Grid -->
    <div class="footer-nav-grid font-dm-sans">
      
      <!-- Brand Column -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo">
          <svg width="24" height="24" viewBox="0 0 7 7.1" fill="currentColor">
            <rect x="0" y="0" width="1" height="1"/>
            <rect x="1" y="0" width="1" height="1"/>
            <rect x="5" y="0" width="1" height="1"/>
            <rect x="6" y="0" width="1" height="1"/>
            <rect x="1" y="1" width="5" height="1"/>
            <rect x="0" y="2" width="7" height="1"/>
            <rect x="0" y="3" width="7" height="1"/>
            <rect x="0" y="4" width="7" height="1.1"/>
            <rect x="0" y="5.1" width="7" height="1.1"/>
            <rect x="0" y="6.2" width="1" height="0.55"/>
            <rect x="3" y="6.2" width="1" height="0.55"/>
            <rect x="6" y="6.2" width="1" height="0.55"/>
          </svg>
          <span class="footer-logo-txt font-dm-sans">tar</span>
        </a>
        <p class="brand-tagline">
          Calm, reliable, and honest messaging software built for organizations that serve people. Native Android app on Google Play (iOS coming soon).
        </p>
      </div>

      <!-- Column 1: Channels -->
      <div class="footer-col">
        <h4 class="col-title">INTERFACES</h4>
        <ul class="col-links">
          {channelLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 2: Capabilities -->
      <div class="footer-col">
        <h4 class="col-title">CAPABILITIES</h4>
        <ul class="col-links">
          {capabilityLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Resources -->
      <div class="footer-col">
        <h4 class="col-title">RESOURCES</h4>
        <ul class="col-links">
          {resourceLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Company -->
      <div class="footer-col">
        <h4 class="col-title">NATIVE APPS</h4>
        <ul class="col-links">
          {companyLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="footer-bottom-bar font-dm-sans">
      <span class="copy-txt">
        © 2026 TAR. Simple, transparent messaging for everyone. Native mobile platform.
      </span>
      <div class="bottom-legal-links">
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
        <a href="#">Security</a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-section {
    background-color: var(--color-canopy-green);
    color: var(--color-paper-white);
    padding: 72px 0 36px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-top-cluster {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 860px) {
    .footer-top-cluster {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-cta-left {
    max-width: 580px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-headline {
    color: #ffffff;
  }

  .footer-sublead {
    font-size: 15px;
    color: var(--color-mint-wash);
    line-height: 1.5;
  }

  .footer-cta-right {
    display: flex;
    align-items: center;
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    padding: 48px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 600px) {
    .footer-nav-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .footer-nav-grid {
      grid-template-columns: 1.5fr repeat(4, 1fr);
      gap: 32px;
    }
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #55dd4a;
    text-decoration: none;
  }

  .footer-logo-txt {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .brand-tagline {
    font-size: 13px;
    color: var(--color-mint-wash);
    line-height: 1.55;
    max-width: 260px;
  }

  .col-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 16px;
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    font-size: 14px;
    color: var(--color-mint-wash);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: #ffffff;
  }

  .footer-bottom-bar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 32px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (min-width: 640px) {
    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .bottom-legal-links {
    display: flex;
    gap: 16px;
  }

  .bottom-legal-links a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }

  .bottom-legal-links a:hover {
    color: #ffffff;
  }
</style>