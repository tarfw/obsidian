---
// Clean, Uncluttered Directory Footer in Canopy Green (#0a3922) — 0 Repetitions & Balanced Grid
import TarLogo from "./TarLogo.astro";
import GooglePlayBadge from "./GooglePlayBadge.astro";

const productLinks = [
  { name: "WhatsApp & Telegram", href: "/#channels" },
  { name: "Voice in 40+ Languages", href: "/#channels" },
  { name: "Unified Team Feed", href: "/#genui" },
  { name: "Offline-First Engine", href: "/#capabilities" }
];

const platformLinks = [
  { name: "TAR Harness Handbook", href: "/harness" },
  { name: "Agent Directory & Rates", href: "/agents" },
  { name: "Developer Documentation", href: "/docs" },
  { name: "Learn (Agents & Brain)", href: "/learn" },
  { name: "Security Architecture", href: "/security" }
];

const companyLinks = [
  { name: "The Manifesto", href: "/manifesto" },
  { name: "Usage-Based Pricing", href: "/#pricing" },
  { name: "Help & Support", href: "/support" },
  { name: "Community Guidelines", href: "/guidelines" }
];
---

<footer class="footer-section room-canopy-green">
  <div class="container footer-container font-dm-sans">
    
    <!-- Navigation Columns Grid -->
    <div class="footer-nav-grid">
      
      <!-- Brand Column -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo" aria-label="TAR Homepage">
          <TarLogo size={28} color="#55dd4a" />
          <span class="footer-logo-txt">tar.</span>
        </a>
        <p class="brand-tagline">
          Calm, honest messaging for everyday commerce and operations.
        </p>
        <div class="brand-badge-wrapper">
          <GooglePlayBadge height={36} />
        </div>
      </div>

      <!-- Column 1: Product -->
      <div class="footer-col">
        <h4 class="col-title">PRODUCT</h4>
        <ul class="col-links">
          {productLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 2: Platform -->
      <div class="footer-col">
        <h4 class="col-title">PLATFORM</h4>
        <ul class="col-links">
          {platformLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div class="footer-col">
        <h4 class="col-title">COMPANY</h4>
        <ul class="col-links">
          {companyLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="footer-bottom-bar">
      <span class="copy-txt">
        © 2026 TAR. Built from Tamil with ❤️ for the world.
      </span>
      <div class="bottom-legal-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-section {
    background-color: var(--color-canopy-green);
    color: var(--color-paper-white);
    padding: 80px 0 48px;
    box-sizing: border-box;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 640px) {
    .footer-nav-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  @media (min-width: 1024px) {
    .footer-nav-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 48px;
    }
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #55dd4a;
    text-decoration: none;
  }

  .footer-logo-txt {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .brand-tagline {
    font-size: 14px;
    color: var(--color-mint-wash);
    opacity: 0.85;
    line-height: 1.6;
    max-width: 280px;
    margin: 0;
  }

  .brand-badge-wrapper {
    margin-top: 4px;
  }

  .col-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 20px 0;
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    font-size: 14px;
    color: var(--color-mint-wash);
    opacity: 0.85;
    text-decoration: none;
    transition: color 0.15s ease, opacity 0.15s ease;
  }

  .footer-link:hover {
    color: #ffffff;
    opacity: 1;
  }

  .footer-bottom-bar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (min-width: 640px) {
    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .bottom-legal-links {
    display: flex;
    gap: 24px;
  }

  .bottom-legal-links a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .bottom-legal-links a:hover {
    color: #ffffff;
  }
</style>