---
// Clean, Human Directory Footer in Canopy Green (#0a3922) — 100vh Room Layout
import TarLogo from "./TarLogo.astro";

const channelLinks = [
  { name: "WhatsApp", href: "/#overview" },
  { name: "Telegram", href: "/#overview" },
  { name: "Websites", href: "/#overview" },
  { name: "Voice in 40+ Languages", href: "/#overview" }
];

const capabilityLinks = [
  { name: "Works Offline", href: "/#capabilities" },
  { name: "Unified Team Feed", href: "/#genui" },
  { name: "Automated Care Loops", href: "/#capabilities" },
  { name: "Zero Per-Seat Fees", href: "/#pricing" }
];

const resourceLinks = [
  { name: "Manifesto", href: "/manifesto" },
  { name: "Documentation", href: "/docs" },
  { name: "Agents & Rates", href: "/agents" },
  { name: "Pricing", href: "/#pricing" },
  { name: "FAQ", href: "/#faq" }
];

const companyLinks = [
  { name: "Google Play Store", href: "https://play.google.com/store/apps" },
  { name: "Privacy Policy", href: "/privacy" },
  { name: "Terms & Conditions", href: "/terms" },
  { name: "Security Architecture", href: "/security" }
];
---

<footer class="footer-section room-canopy-green">
  <div class="container footer-container font-dm-sans">
    
    <!-- Navigation Columns Grid -->
    <div class="footer-nav-grid">
      
      <!-- Brand Column -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo" aria-label="TAR Homepage">
          <TarLogo size={28} color="#55dd4a" />
          <span class="footer-logo-txt">tar.</span>
        </a>
        <p class="brand-tagline">
          Calm, honest messaging for everyday commerce and operations.
        </p>
      </div>

      <!-- Column 1: Channels -->
      <div class="footer-col">
        <h4 class="col-title">INTERFACES</h4>
        <ul class="col-links">
          {channelLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 2: Capabilities -->
      <div class="footer-col">
        <h4 class="col-title">CAPABILITIES</h4>
        <ul class="col-links">
          {capabilityLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Resources -->
      <div class="footer-col">
        <h4 class="col-title">RESOURCES</h4>
        <ul class="col-links">
          {resourceLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Legal & Apps -->
      <div class="footer-col">
        <h4 class="col-title">LEGAL & APPS</h4>
        <ul class="col-links">
          {companyLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.name}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="footer-bottom-bar">
      <span class="copy-txt">
        © 2026 TAR. Built from Tamil with ❤️ for the world.
      </span>
      <div class="bottom-legal-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/security">Security</a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-section {
    background-color: var(--color-canopy-green);
    color: var(--color-paper-white);
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 600px) {
    .footer-nav-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .footer-nav-grid {
      grid-template-columns: 1.4fr repeat(4, 1fr);
      gap: 36px;
    }
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #55dd4a;
    text-decoration: none;
  }

  .footer-logo-txt {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .brand-tagline {
    font-size: 14px;
    color: var(--color-mint-wash);
    line-height: 1.6;
    max-width: 260px;
    margin: 0;
  }

  .col-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 16px;
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    font-size: 14px;
    color: var(--color-mint-wash);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: #ffffff;
  }

  .footer-bottom-bar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (min-width: 640px) {
    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .bottom-legal-links {
    display: flex;
    gap: 18px;
  }

  .bottom-legal-links a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .bottom-legal-links a:hover {
    color: #ffffff;
  }
</style>