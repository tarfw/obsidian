---
// Human-Centric Hero Section in Turn.io Canopy Green (#0a3922)
// Clean 3-line Headline, Non-repetitive Lead, and 10 Official Brand Logos
---

<section class="human-hero-section room-canopy-green" id="overview">
  <div class="container hero-container-grid">
    
    <!-- Left: Editorial Headline & Non-Repetitive Lead -->
    <div class="hero-text-col">
      <h1 class="display-hero hero-heading">
        Workforce,<br />
        Business and Agents<br />
        <span class="text-leaf-bright">on Millions of Interfaces.</span>
      </h1>

      <p class="hero-lead font-dm-sans">
        An open system connecting your operations to
        
        <!-- 1. TarApp -->
        <span class="hero-channel-badge">
          <span class="badge-icon bg-tarapp" title="TarApp">
            <svg viewBox="0 0 7 7.1" width="11" height="11" fill="currentColor">
              <rect x="0" y="0" width="1" height="1"/>
              <rect x="1" y="0" width="1" height="1"/>
              <rect x="5" y="0" width="1" height="1"/>
              <rect x="6" y="0" width="1" height="1"/>
              <rect x="1" y="1" width="5" height="1"/>
              <rect x="0" y="2" width="7" height="1"/>
              <rect x="0" y="3" width="7" height="1"/>
              <rect x="0" y="4" width="7" height="1.1"/>
              <rect x="0" y="5.1" width="7" height="1.1"/>
            </svg>
          </span>
          <span class="badge-name">TarApp</span>
        </span>,

        <!-- 2. Web Sites -->
        <span class="hero-channel-badge">
          <span class="badge-icon bg-websites" title="Web Sites">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </span>
          <span class="badge-name">Web Sites</span>
        </span>,

        <!-- 3. WhatsApp -->
        <span class="hero-channel-badge">
          <span class="badge-icon bg-whatsapp" title="WhatsApp">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.41a8.167 8.167 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.188 8.188 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24h.02z"/>
            </svg>
          </span>
          <span class="badge-name">WhatsApp</span>
        </span>,

        <!-- 4. Telegram -->
        <span class="hero-channel-badge">
          <span class="badge-icon bg-telegram" title="Telegram">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </span>
          <span class="badge-name">Telegram</span>
        </span>,

        <!-- 5. Discord -->
        <span class="hero-channel-badge">
          <span class="badge-icon bg-discord" title="Discord">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          </span>
          <span class="badge-name">Discord</span>
        </span>,

        <!-- 6. Slack -->
        <span class="hero-channel-badge">
          <span class="badge-icon bg-slack" title="Slack">
            <svg viewBox="0 0 24 24" width="13" height="13">
              <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313z" fill="#E01E5A"/>
              <path d="M8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312z" fill="#36C5F0"/>
              <path d="M18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312z" fill="#2EB67D"/>
              <path d="M15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z" fill="#ECB22E"/>
            </svg>
          </span>
          <span class="badge-name">Slack</span>
        </span>,

        <!-- 7. Google Chat -->
        <span class="hero-channel-badge">
          <span class="badge-icon bg-gchat" title="Google Chat">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12c0 2.14.67 4.12 1.82 5.75L2.5 22l4.42-1.28C8.38 21.46 10.13 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/>
            </svg>
          </span>
          <span class="badge-name">Google Chat</span>
        </span>,

        <!-- 8. MS Teams -->
        <span class="hero-channel-badge">
          <span class="badge-icon bg-teams" title="MS Teams">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
              <path d="M19.5 7.5a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5zm-5-1.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-5 1.5a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5zM22 9h-5a1 1 0 0 0-1 1v6.5a2.5 2.5 0 0 0 5 0V10a1 1 0 0 0-1-1zm-9-1h-6a1 1 0 0 0-1 1v8a3 3 0 0 0 6 0V9a1 1 0 0 0-1-1zm-9 1H2a1 1 0 0 0-1 1v4.5a2.5 2.5 0 0 0 5 0V10a1 1 0 0 0-1-1z"/>
            </svg>
          </span>
          <span class="badge-name">MS Teams</span>
        </span>,

        <!-- 9. POS -->
        <span class="hero-channel-badge">
          <span class="badge-icon bg-pos" title="POS">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
              <path d="M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm2 3v3h12V6H6zm0 5v2h2v-2H6zm4 0v2h2v-2h-2zm4 0v2h4v-2h-4zm-8 4v2h2v-2H6zm4 0v2h2v-2h-2zm4 0v2h4v-2h-4z"/>
            </svg>
          </span>
          <span class="badge-name">POS</span>
        </span>,

        <!-- 10. Voice -->
        <span class="hero-channel-badge">
          <span class="badge-icon bg-voice" title="Voice">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
              <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
              <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
            </svg>
          </span>
          <span class="badge-name">Voice</span>
        </span>,

        and other interfaces people use every day.
      </p>
    </div>

    <!-- Right: Clean WhatsApp Dark Mode Mockup (No Background Code) -->
    <div class="hero-visual-col">
      <div class="dark-window-frame font-dm-sans">
        
        <!-- macOS Window Controls Top-Left -->
        <div class="window-controls-bar">
          <span class="window-dot"></span>
          <span class="window-dot"></span>
          <span class="window-dot"></span>
        </div>

        <!-- 3 Clean WhatsApp Dark Mode Message Cards -->
        <div class="whatsapp-cards-stack">
          
          <!-- Message 1: Appointment Reminder with Reschedule Button -->
          <div class="wa-bubble-card">
            <div class="wa-bubble-main">
              <p class="wa-msg-text">
                Reminder: you have an appointment on 3 Sep at 14:30. We look forward to seeing you.
              </p>
              <span class="wa-timestamp">9:42 AM</span>
            </div>
            <button class="wa-action-bar-btn font-dm-sans">
              <span class="wa-btn-icon">↩</span>
              <span>Reschedule</span>
            </button>
          </div>

          <!-- Message 2: Delivery Update -->
          <div class="wa-bubble-card">
            <div class="wa-bubble-main">
              <p class="wa-msg-text">
                Your order #4821 is out for delivery, arriving Wednesday. Thanks for shopping with us.
              </p>
              <span class="wa-timestamp">9:43 AM</span>
            </div>
          </div>

          <!-- Message 3: Subscription Renewal with View Plan Button -->
          <div class="wa-bubble-card">
            <div class="wa-bubble-main">
              <p class="wa-msg-text">
                Your subscription renews on 3 Sep for €12.00. No action is needed.
              </p>
              <span class="wa-timestamp">9:44 AM</span>
            </div>
            <button class="wa-action-bar-btn font-dm-sans">
              <span class="wa-btn-icon">↗</span>
              <span>View plan</span>
            </button>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .human-hero-section {
    background-color: var(--color-canopy-green);
    color: var(--color-paper-white);
    min-height: calc(100vh - 68px);
    display: flex;
    align-items: center;
    padding: 24px 0;
    overflow: hidden;
  }

  @supports (min-height: 100svh) {
    .human-hero-section {
      min-height: calc(100svh - 68px);
    }
  }

  .hero-container-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
    width: 100%;
  }

  @media (min-width: 960px) {
    .hero-container-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 40px;
    }
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero-heading {
    color: var(--color-paper-white);
    line-height: 1.06;
    font-size: clamp(2.2rem, 3.8vw, 3.4rem);
  }

  .text-leaf-bright {
    color: var(--color-leaf-bright);
  }

  .hero-lead {
    font-size: clamp(0.95rem, 1.3vw, 1.12rem);
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.84);
    max-width: 620px;
  }

  /* Inline Channel Badges with Official Brand SVGs */
  .hero-channel-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    vertical-align: -2px;
    margin: 0 1px;
    color: #ffffff;
    font-weight: 600;
  }

  .badge-icon {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  .badge-name {
    color: #ffffff;
    font-weight: 600;
  }

  .bg-tarapp { background-color: #072e1b; color: #55dd4a; }
  .bg-websites { background-color: #0284c7; }
  .bg-whatsapp { background-color: #25d366; }
  .bg-telegram { background-color: #24a1de; }
  .bg-discord { background-color: #5865f2; }
  .bg-slack { background-color: #ffffff; }
  .bg-gchat { background-color: #00ac47; }
  .bg-teams { background-color: #5059c9; }
  .bg-pos { background-color: #f59e0b; }
  .bg-voice { background-color: #e11d48; }

  /* Right Visual: Clean Dark Window Container */
  .hero-visual-col {
    display: flex;
    justify-content: center;
  }

  .dark-window-frame {
    width: 100%;
    max-width: 410px;
    background-color: #232724;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.4);
    padding: 14px 16px 20px 16px;
    display: flex;
    flex-direction: column;
  }

  .window-controls-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 12px;
  }

  .window-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #525854;
  }

  /* 3 Centered WhatsApp Dark Mode Message Cards */
  .whatsapp-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .wa-bubble-card {
    background-color: #2b302c;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    overflow: hidden;
    color: #e9edef;
  }

  .wa-bubble-main {
    padding: 12px 14px 8px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .wa-msg-text {
    font-size: 13px;
    line-height: 1.4;
    color: #f1f3f4;
    margin: 0;
  }

  .wa-timestamp {
    align-self: flex-end;
    font-size: 10px;
    color: #8e9590;
    line-height: 1;
    margin-top: 2px;
  }

  .wa-action-bar-btn {
    width: 100%;
    background: transparent;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 8px 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: #22c55e;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .wa-action-bar-btn:hover {
    background-color: rgba(34, 197, 94, 0.08);
  }

  .wa-btn-icon {
    font-size: 13px;
  }
</style>
