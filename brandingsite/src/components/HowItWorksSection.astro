---
// Up and Running in 5 Minutes — Clean, Compact & Direct
const steps = [
  {
    num: "1",
    title: "Download App",
    desc: "Install TAR on Android. Your store database and catalog initialize offline instantly."
  },
  {
    num: "2",
    title: "Connect Channels",
    desc: "Link WhatsApp, Telegram, or Web links with zero server configuration."
  },
  {
    num: "3",
    title: "Go Live & Invite Team (₹0)",
    desc: "AI handles customer replies at direct cost. Add unlimited team members for ₹0."
  }
];
---

<section class="setup-editorial-section pastel-room-mint" id="setup">
  <div class="container">
    
    <div class="editorial-split-grid">
      <!-- Left Column: Simple Direct Headline -->
      <div class="editorial-story-col">
        <h2 class="display-section-lg editorial-heading">
          Up and running<br />
          in 5 minutes.
        </h2>
        
        <p class="editorial-narrative font-dm-sans">
          No complex setup or technical consultants. Connect your channels, automate customer replies, and invite your entire team for free.
        </p>
      </div>

      <!-- Right Column: 3 Clean Compact Steps -->
      <div class="editorial-steps-col">
        {steps.map((s) => (
          <div class="step-item-row font-dm-sans">
            <div class="step-badge">{s.num}</div>
            <div class="step-text-block">
              <h3 class="step-title">{s.title}</h3>
              <p class="step-desc">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .setup-editorial-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .editorial-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }

  @media (min-width: 860px) {
    .editorial-split-grid {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }
  }

  .editorial-story-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 480px;
  }

  .editorial-heading {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .editorial-narrative {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-graphite);
    margin: 0;
  }

  .editorial-steps-col {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .step-item-row {
    display: flex;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    align-items: flex-start;
  }

  .step-badge {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--color-canopy-green);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
  }

  .step-text-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .step-title {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--color-canopy-green);
    margin: 0;
  }

  .step-desc {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-graphite);
    margin: 0;
  }
</style>
