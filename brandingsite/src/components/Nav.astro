---
// Clean Transparent Header Navigation in Canopy Green with Official Google Play Badge
import GooglePlayBadge from "./GooglePlayBadge.astro";
---

<header class="clean-nav-header">
  <div class="container nav-inner">
    
    <!-- Left: Brand Logo -->
    <a href="/" class="nav-logo" aria-label="TAR Homepage">
      <svg class="logo-icon" width="26" height="26" viewBox="0 0 7 7.1" fill="currentColor">
        <rect x="0" y="0" width="1" height="1"/>
        <rect x="1" y="0" width="1" height="1"/>
        <rect x="5" y="0" width="1" height="1"/>
        <rect x="6" y="0" width="1" height="1"/>
        <rect x="1" y="1" width="5" height="1"/>
        <rect x="0" y="2" width="7" height="1"/>
        <rect x="0" y="3" width="7" height="1"/>
        <rect x="0" y="4" width="7" height="1.1"/>
        <rect x="0" y="5.1" width="7" height="1.1"/>
        <rect x="0" y="6.2" width="1" height="0.55"/>
        <rect x="3" y="6.2" width="1" height="0.55"/>
        <rect x="6" y="6.2" width="1" height="0.55"/>
      </svg>
      <span class="logo-text font-dm-sans">tar</span>
    </a>

    <!-- Center: Clean Menu Links -->
    <nav class="nav-menu" aria-label="Main Navigation">
      <a href="#overview" class="nav-link">Overview</a>
      <a href="#setup" class="nav-link">How It Works</a>
      <a href="#capabilities" class="nav-link">Capabilities</a>
      <a href="#genui" class="nav-link">Experience</a>
      <a href="#pricing" class="nav-link">Pricing</a>
      <a href="#faq" class="nav-link">FAQ</a>
    </nav>

    <!-- Right: Official Google Play Store Badge -->
    <div class="nav-right-actions">
      <GooglePlayBadge height={36} />
    </div>

    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle Navigation">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-nav-drawer" id="mobileNavDrawer">
    <div class="container mobile-drawer-inner">
      <a href="#overview" class="mobile-link">Overview</a>
      <a href="#setup" class="mobile-link">How It Works</a>
      <a href="#capabilities" class="mobile-link">Capabilities</a>
      <a href="#genui" class="mobile-link">Experience</a>
      <a href="#pricing" class="mobile-link">Pricing</a>
      <a href="#faq" class="mobile-link">FAQ</a>
      <div class="mobile-drawer-cta">
        <GooglePlayBadge height={40} class="full-width" />
      </div>
    </div>
  </div>
</header>

<script>
  const initNav = () => {
    const btn = document.getElementById('mobileMenuBtn');
    const drawer = document.getElementById('mobileNavDrawer');
    if (!btn || !drawer) return;

    btn.addEventListener('click', () => {
      drawer.classList.toggle('open');
      btn.classList.toggle('active');
    });

    const links = drawer.querySelectorAll('.mobile-link');
    links.forEach(l => l.addEventListener('click', () => {
      drawer.classList.remove('open');
      btn.classList.remove('active');
    }));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }
</script>

<style>
  .clean-nav-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-canopy-green);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    height: 68px;
    display: flex;
    align-items: center;
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-icon {
    color: #55dd4a;
  }

  .logo-text {
    font-size: 23px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .nav-menu {
    display: none;
    align-items: center;
    gap: 4px;
  }

  @media (min-width: 860px) {
    .nav-menu {
      display: flex;
    }
  }

  .nav-link {
    font-family: var(--font-dm-sans);
    font-size: 14.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    padding: 7px 14px;
    border-radius: 8px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
  }

  .nav-right-actions {
    display: flex;
    align-items: center;
  }

  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  @media (min-width: 860px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .bar {
    width: 20px;
    height: 2px;
    background-color: #ffffff;
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-menu-btn.active .bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }

  .mobile-menu-btn.active .bar:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-nav-drawer {
    display: none;
    position: absolute;
    top: 68px;
    left: 0;
    right: 0;
    background-color: var(--color-canopy-green);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    padding: 24px 0;
  }

  .mobile-nav-drawer.open {
    display: block;
  }

  .mobile-drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-link {
    font-size: 16px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .mobile-drawer-cta {
    margin-top: 8px;
    display: flex;
    justify-content: center;
  }
</style>