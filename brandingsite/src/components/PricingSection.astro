---
// Authentic TAR Credit Pricing — Bird.com Editorial Style (Cream Wash Room #faf7e8)
const packs = [
  {
    name: "Base Activation",
    price: "₹500",
    credits: "1,000 Credits (₹100 Wallet)",
    details: "Includes ₹400 onboarding fee + ₹100 pre-loaded credit balance. Covers 8+ months of typical operations.",
    badge: "One-Time Activation"
  },
  {
    name: "Starter Top-Up",
    price: "₹100",
    credits: "1,000 Credits (100% Wallet)",
    details: "Pure at-cost usage credits. Refills balance anytime with zero expiration and zero token markups.",
    badge: "On-Demand"
  },
  {
    name: "Growth Top-Up",
    price: "₹500",
    credits: "5,000 Credits (100% Wallet)",
    details: "For active clinics and shops running high-volume daily WhatsApp CRM, voice orders, and invoice scans.",
    badge: "Most Popular"
  }
];

const operationsCost = [
  { task: "Customer WhatsApp / Chat Reply", cost: "~₹0.002 / reply", note: "1 credit = 50 replies" },
  { task: "Voice Note Transcription to Order", cost: "~₹0.03 / order", note: "Whisper audio in 40+ languages" },
  { task: "Document / Invoice OCR Scan", cost: "~₹0.005 / page", note: "Instant receipt & bill parsing" },
  { task: "Commercial Quote or Proposal", cost: "~₹0.025 / doc", note: "Custom PDF generation" },
  { task: "Active Owned Workspace Hosting", cost: "₹10.00 / month", note: "100 credits / mo for dedicated edge sync" },
  { task: "Invited Team Members & Staff", cost: "₹0.00 (Free)", note: "Unlimited staff, cashiers & doctors" }
];
---

<section class="tar-pricing-section pastel-room-cream reveal-item" id="pricing">
  <div class="container">
    
    <!-- Section Header -->
    <div class="pricing-editorial-header">
      <h2 class="display-section-lg section-title">
        One simple credit wallet.<br />
        Zero seat license markups.
      </h2>
      <p class="section-lead font-dm-sans">
        Traditional software vendors charge ₹10,000 to ₹25,000 every month just for seat licenses. TAR charges strictly for actual operations consumed at 100% direct at-cost pass-through.
      </p>
    </div>

    <!-- Pricing Packs List with Dividers (Bird.com Style) -->
    <div class="pricing-packs-row font-dm-sans">
      {packs.map((p) => (
        <div class="pack-editorial-item">
          <div class="pack-top-bar">
            <span class="pack-badge">{p.badge}</span>
            <h3 class="pack-name">{p.name}</h3>
          </div>

          <div class="pack-price-cluster">
            <span class="pack-price">{p.price}</span>
            <span class="pack-credits">{p.credits}</span>
          </div>

          <p class="pack-details">{p.details}</p>

          <a href="https://play.google.com/store/apps" target="_blank" rel="noopener noreferrer" class="btn-pack-dark pack-cta">
            Select in App
          </a>
        </div>
      ))}
    </div>

    <!-- Transparent At-Cost Operations Breakdown Table -->
    <div class="at-cost-table-box font-dm-sans">
      <div class="table-title-bar">
        <h3 class="table-heading">Transparent Pass-Through Operation Rates</h3>
        <span class="table-subnote">1 Credit = ₹0.10 (10 Paise) · Zero Token Profit Markup</span>
      </div>

      <div class="rates-table-wrapper">
        <table class="rates-table">
          <thead>
            <tr>
              <th>Operation / Capability</th>
              <th>Direct At-Cost Rate</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {operationsCost.map((op) => (
              <tr>
                <td class="op-name"><strong>{op.task}</strong></td>
                <td class="op-cost font-mono">{op.cost}</td>
                <td class="op-note">{op.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Typical Business Monthly Example -->
    <div class="monthly-example-strip font-dm-sans">
      <div class="example-left">
        <strong>Typical Monthly Active Clinic:</strong>
        <span>1 Workspace (₹10) + 500 WhatsApp replies (₹1) + 50 Voice Orders (₹1.50) + 100 Bill Scans (₹0.52)</span>
      </div>
      <div class="example-right">
        <span class="example-total-lbl">Total Estimated Cost:</span>
        <strong class="example-total-val">~₹13.02 / month</strong>
      </div>
    </div>

  </div>
</section>

<style>
  .tar-pricing-section {
    padding: var(--section-gap) 0;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .pricing-editorial-header {
    max-width: 820px;
    margin-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .section-lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-graphite);
  }

  /* Packs 3-Column Editorial Row */
  .pricing-packs-row {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    margin-bottom: 48px;
  }

  @media (min-width: 768px) {
    .pricing-packs-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pack-editorial-item {
    padding: 32px 28px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    border-right: 1px solid rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 14px;
    background-color: rgba(255, 255, 255, 0.4);
    transition: background-color 0.15s ease;
  }

  .pack-editorial-item:hover {
    background-color: #ffffff;
  }

  .pack-top-bar {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pack-badge {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 700;
    color: var(--color-canopy-green);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pack-name {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-canopy-green);
  }

  .pack-price-cluster {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pack-price {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-canopy-green);
    line-height: 1;
  }

  .pack-credits {
    font-size: 12.5px;
    color: var(--color-slate);
    font-weight: 600;
  }

  .pack-details {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-graphite);
    flex: 1;
  }

  .btn-pack-dark {
    text-align: center;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    background-color: var(--color-canopy-green);
    color: #ffffff;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .btn-pack-dark:hover {
    background-color: #124d30;
  }

  /* Rates Table */
  .at-cost-table-box {
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: var(--radius-cards);
    overflow: hidden;
    margin-bottom: 24px;
  }

  .table-title-bar {
    background-color: var(--color-canopy-green);
    color: #ffffff;
    padding: 16px 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .table-heading {
    font-size: 16px;
    font-weight: 700;
  }

  .table-subnote {
    font-size: 12px;
    color: var(--color-leaf-bright);
  }

  .rates-table-wrapper {
    overflow-x: auto;
  }

  .rates-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    text-align: left;
  }

  .rates-table th {
    background-color: #f7f9f8;
    padding: 12px 24px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-slate);
    border-bottom: 1px solid var(--color-frost-gray);
  }

  .rates-table td {
    padding: 14px 24px;
    border-bottom: 1px solid var(--color-frost-gray);
    color: var(--color-ink-black);
  }

  .rates-table tr:last-child td {
    border-bottom: none;
  }

  .op-name strong {
    color: var(--color-canopy-green);
  }

  .op-cost {
    color: var(--color-canopy-green);
    font-weight: 700;
  }

  .op-note {
    color: var(--color-graphite);
    font-size: 12.5px;
  }

  /* Monthly Example Strip */
  .monthly-example-strip {
    background-color: var(--color-mint-wash);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-cards-sm);
    padding: 18px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 768px) {
    .monthly-example-strip {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .example-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--color-canopy-green);
  }

  .example-right {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-shrink: 0;
  }

  .example-total-lbl {
    font-size: 12px;
    color: var(--color-slate);
  }

  .example-total-val {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-canopy-green);
  }
</style>
