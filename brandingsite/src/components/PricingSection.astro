---

<section class="pricing-clean-section" id="pricing">
  <div class="pricing-clean-inner">
    
    <!-- Title & Summary -->
    <div class="pricing-intro">
      <span class="pricing-kicker">Tar Pricing</span>
      <h2 class="pricing-title">Simple credit pricing</h2>
      <p class="pricing-lead">
        Base activation is ₹500 (includes ₹100 pre-loaded usage credits). Top up anytime on demand at 100% direct at-cost pass-through.
      </p>
    </div>

    <!-- 1. Workspaces and Credits -->
    <div class="pricing-block">
      <h3 class="block-title">1. Workspaces and Credits</h3>
      <p class="block-sub">Monthly workspace credits are reserved first. AI automation inside a workspace uses its owner's wallet.</p>

      <div class="table-container">
        <table class="clean-table">
          <thead>
            <tr>
              <th>Workspace usage</th>
              <th class="text-right">Credits</th>
            </tr>
          </thead>
          <tbody>
            {workspaces.map((w) => (
              <tr>
                <td>
                  <strong class="row-main-text">{w.usage}</strong>
                  <span class="table-note">{w.note}</span>
                </td>
                <td class="text-right credit-val">{w.credits}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- 2. Agents and Credits -->
    <div class="pricing-block" id="agents">
      <h3 class="block-title">2. Agents and Credits</h3>
      <p class="block-sub">Local on-device queries use 0 credits. Cloud DB syncs, agent actions, and research swarms are charged at exact pass-through cost.</p>

      <div class="table-container">
        <table class="clean-table">
          <thead>
            <tr>
              <th>Agent action / Operation</th>
              <th class="text-right">Credit Cost</th>
              <th class="text-right">At-Cost INR</th>
            </tr>
          </thead>
          <tbody>
            {agentGroups.map((group) => (
              <>
                <tr class="group-header-row">
                  <td colspan="3">
                    <div class="group-title-wrap">
                      <span class="tar-pixel-logo" style={`color: ${group.color}`}>
                        <svg width="18" height="18" viewBox="0 0 7 7.1" fill="currentColor" aria-hidden="true">
                          <rect x="0" y="0.000" width="1" height="1.000"/>
                          <rect x="1" y="0.000" width="1" height="1.000"/>
                          <rect x="5" y="0.000" width="1" height="1.000"/>
                          <rect x="6" y="0.000" width="1" height="1.000"/>
                          <rect x="1" y="1.000" width="1" height="1.000"/>
                          <rect x="2" y="1.000" width="1" height="1.000"/>
                          <rect x="3" y="1.000" width="1" height="1.000"/>
                          <rect x="4" y="1.000" width="1" height="1.000"/>
                          <rect x="5" y="1.000" width="1" height="1.000"/>
                          <rect x="0" y="2.000" width="1" height="1.000"/>
                          <rect x="1" y="2.000" width="1" height="1.000"/>
                          <rect x="2" y="2.000" width="1" height="1.000"/>
                          <rect x="3" y="2.000" width="1" height="1.000"/>
                          <rect x="4" y="2.000" width="1" height="1.000"/>
                          <rect x="5" y="2.000" width="1" height="1.000"/>
                          <rect x="6" y="2.000" width="1" height="1.000"/>
                          <rect x="0" y="3.000" width="1" height="1.000"/>
                          <rect x="1" y="3.000" width="1" height="1.000"/>
                          <rect x="3" y="3.000" width="1" height="1.000"/>
                          <rect x="5" y="3.000" width="1" height="1.000"/>
                          <rect x="6" y="3.000" width="1" height="1.000"/>
                          <rect x="0" y="4.000" width="1" height="1.100"/>
                          <rect x="1" y="4.000" width="1" height="1.100"/>
                          <rect x="2" y="4.000" width="1" height="1.100"/>
                          <rect x="3" y="4.000" width="1" height="1.100"/>
                          <rect x="4" y="4.000" width="1" height="1.100"/>
                          <rect x="5" y="4.000" width="1" height="1.100"/>
                          <rect x="6" y="4.000" width="1" height="1.100"/>
                          <rect x="0" y="5.100" width="1" height="1.100"/>
                          <rect x="1" y="5.100" width="1" height="1.100"/>
                          <rect x="2" y="5.100" width="1" height="1.100"/>
                          <rect x="3" y="5.100" width="1" height="1.100"/>
                          <rect x="4" y="5.100" width="1" height="1.100"/>
                          <rect x="5" y="5.100" width="1" height="1.100"/>
                          <rect x="6" y="5.100" width="1" height="1.100"/>
                          <rect x="0" y="6.200" width="1" height="0.550"/>
                          <rect x="3" y="6.200" width="1" height="0.550"/>
                          <rect x="6" y="6.200" width="1" height="0.550"/>
                          <rect x="3" y="6.750" width="1" height="0.350"/>
                        </svg>
                      </span>
                      <span class="group-title-text">{group.title}</span>
                    </div>
                  </td>
                </tr>
                {group.actions.map((act) => (
                  <tr class="action-item-row">
                    <td><span class="action-name">{act.name}</span></td>
                    <td class:list={["text-right", "credit-val", { "credit-val--free": act.isFree }]}>{act.credits}</td>
                    <td class="text-right"><span class="inr-sub-val">{act.inr}</span></td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- 3. Credits and Cost -->
    <div class="pricing-block">
      <h3 class="block-title">3. Credits and Cost</h3>
      <p class="block-sub">Initial activation costs ₹500 (includes ₹100 direct credit wallet value). All top-ups pass through 100% at-cost credit value without expiration.</p>

      <div class="table-container">
        <table class="clean-table">
          <thead>
            <tr>
              <th>Pack</th>
              <th>Price</th>
              <th>Credits Included</th>
              <th>Structure</th>
              <th class="text-right">Best for</th>
            </tr>
          </thead>
          <tbody>
            {creditPacks.map((pack) => (
              <tr>
                <td><strong class="row-main-text">{pack.pack}</strong></td>
                <td><span class="pack-price-text">{pack.price}</span></td>
                <td><span class="credit-unit-pill">{pack.credits}</span></td>
                <td><span class="pack-unit-text">{pack.breakdown}</span></td>
                <td class="text-right"><span class="table-note-inline">{pack.suitable}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- 4. Model and Credits Calculation -->
    <div class="pricing-block">
      <h3 class="block-title">4. Model and Credits Calculation</h3>
      <p class="block-sub">Zero-profit, zero-loss pass-through calculation: real AI provider API rates, per-task token volumes, and edge database costs map directly to credits with 100% transparency.</p>

      <!-- Compact Model Table with explicit Token Volumes, Credits and INR -->
      <div class="table-container model-table-wrap">
        <table class="clean-table">
          <thead>
            <tr>
              <th>Tier / Capability</th>
              <th>Model & API Rate</th>
              <th>Tokens per Task (In / Out)</th>
              <th class="text-right">Credit Cost (Unit)</th>
              <th class="text-right">At-Cost INR (Unit)</th>
              <th class="text-right">Scope / Tasks</th>
            </tr>
          </thead>
          <tbody>
            {modelTiers.map((tier) => (
              <tr>
                <td><strong class="row-main-text">{tier.tier}</strong></td>
                <td>
                  <span class="model-badge">{tier.modelName}</span>
                  <span class="model-cost-sub">{tier.rawCost}</span>
                </td>
                <td><span class="token-usage-tag">{tier.tokenUsage}</span></td>
                <td class="text-right"><span class="credit-unit-pill">{tier.creditsWithUnit}</span></td>
                <td class="text-right"><span class="inr-unit-pill">{tier.inrWithUnit}</span></td>
                <td class="text-right"><span class="table-note-inline">{tier.tasks}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Dedicated ₹100 = 1,000 Credits Purchasing Power Table -->
      <div class="calc-example-box" style="margin-top: 24px;">
        <h4 class="calc-example-title">How ₹100 = 1,000 Credits is Calculated (Zero Profit Margin)</h4>
        <p class="calc-example-sub">1 Credit = ₹0.10 (10 Paise = ~$0.001156 USD). Here is what ₹100 (1,000 Credits) buys at exact pass-through provider cost:</p>

        <div class="table-container" style="background: #ffffff !important; margin-top: 12px;">
          <table class="clean-table">
            <thead>
              <tr>
                <th>Infrastructure / Agent Capability</th>
                <th>Underlying Model & Rate</th>
                <th>At-Cost Unit Rate</th>
                <th class="text-right">Capacity for ₹100 (1,000 cr)</th>
                <th class="text-right">Total Tokens / Data for ₹100</th>
              </tr>
            </thead>
            <tbody>
              {hundredRupeesBreakdown.map((item) => (
                <tr>
                  <td><strong class="row-main-text">{item.capability}</strong></td>
                  <td><span class="table-note-inline">{item.model}</span></td>
                  <td><span class="token-usage-tag">{item.unitRate}</span></td>
                  <td class="text-right"><strong class="credit-val" style="color: #059669 !important;">{item.capacityFor100Rs}</strong></td>
                  <td class="text-right"><span class="table-note-inline">{item.tokensFor100Rs}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Compact Sample Monthly Calculation Table with Token Volumes -->
      <div class="calc-example-box">
        <h4 class="calc-example-title">Example Monthly Business Consumption</h4>
        <p class="calc-example-sub">How an active business consumes tokens & credits at direct provider cost:</p>

        <div class="table-container" style="background: #ffffff !important; margin-top: 12px;">
          <table class="clean-table">
            <thead>
              <tr>
                <th>Activity</th>
                <th>Underlying Model</th>
                <th>Monthly Volume</th>
                <th>Total Tokens Consumed</th>
                <th class="text-right">Credits</th>
                <th class="text-right">At-Cost INR</th>
              </tr>
            </thead>
            <tbody>
              {sampleCalculation.map((calc) => (
                <tr>
                  <td><strong class="row-main-text">{calc.item}</strong></td>
                  <td><span class="table-note-inline">{calc.modelUsed}</span></td>
                  <td><span class="table-note-inline">{calc.volume}</span></td>
                  <td><span class="token-usage-tag">{calc.tokensUsed}</span></td>
                  <td class="text-right"><span class="credit-val">{calc.credits}</span></td>
                  <td class="text-right inr-sub-val">{calc.inr}</td>
                </tr>
              ))}
              <tr class="calc-total-row">
                <td colspan="4"><strong style="color: #0a0a0a !important;">Total Monthly Need</strong></td>
                <td class="text-right"><strong class="credit-val" style="color: #059669 !important; font-size: 1rem;">~121.6 cr</strong></td>
                <td class="text-right"><strong class="inr-total-highlight">~₹12.18 / mo</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
        
        <div class="calc-summary-footer">
          <span class="calc-pack-badge">The pre-loaded <strong>₹100 wallet credits (1,000 cr)</strong> from the Base Pack covers <strong>8+ months</strong> of active operations</span>
          <span class="calc-rollover-note">Subsequent top-ups (₹100 = 1,000 cr) refill 100% of payment directly into your credit wallet with 0% token profit markup.</span>
        </div>
      </div>
    </div>

    <!-- Footnote -->
    <div class="clean-footnote">
      <p>
        * Prices are localized worldwide using purchasing power, taxes, and store costs. Purchased credits do not expire while the account is active. Third-party charges such as WhatsApp, SMS, domains, and payment processing are separate. The ₹500 base pack includes ₹400 platform onboarding fee and ₹100 pre-loaded credit balance (1,000 credits @ ₹0.10/credit). Subsequent top-ups are credited 100% directly to the wallet at zero token profit margin.
      </p>
    </div>

  </div>
</section>

