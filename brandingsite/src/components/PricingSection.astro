---
const packs = [
  { name: "Base Pack", price: "₹0", desc: "Free forever. Offline sales, catalog, inventory, unlimited team." },
  { name: "Work Pack", price: "₹500 / mo", desc: "Cloud sync, WhatsApp messaging, 1,000 credits / mo." },
  { name: "Top-Up Refill", price: "From ₹100", desc: "₹100 = 1,000 credits. Refill anytime, never expires." }
];
---

<section class="tar-pricing-section" id="pricing">
  <div class="container">

    <div class="section-head-left">
      <h2 class="display-section-lg section-title">
        Simple credit pricing.
      </h2>
      <p class="section-lead font-dm-sans">
        1 Credit = ₹0.10. No seat fees.
      </p>
    </div>

    <div class="packs-horizontal-grid font-dm-sans">
      {packs.map((p) => (
        <div class="pack-card">
          <h3 class="pack-name">{p.name}</h3>
          <div class="pack-price font-mono">{p.price}</div>
          <p class="pack-desc">{p.desc}</p>
        </div>
      ))}
    </div>

    <div class="pricing-bottom-bar font-dm-sans">
      <a href="/agents" class="agents-link">
        <span>View Detailed Agent & Model Rates</span>
        <span class="arrow">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .tar-pricing-section {
    background-color: #ffffff;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .section-head-left {
    max-width: 720px;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .section-lead {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-graphite);
    margin: 0;
  }

  /* 3 Horizontal Pack Cards Side-by-Side */
  .packs-horizontal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    margin-bottom: 24px;
  }

  @media (max-width: 580px) {
    .packs-horizontal-grid {
      grid-template-columns: 1fr;
    }
  }

  .pack-card {
    background-color: #f4f7f5;
    border-radius: 14px;
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-sizing: border-box;
  }

  .pack-card:hover {
    background-color: #eaf0ec;
  }

  .pack-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-graphite);
    margin: 0;
  }

  .pack-price {
    font-size: 30px;
    font-weight: 700;
    color: var(--color-canopy-green);
    line-height: 1.1;
  }

  .pack-desc {
    font-size: 13.5px;
    color: var(--color-graphite);
    line-height: 1.5;
    margin: 0;
  }

  /* Bottom Link */
  .pricing-bottom-bar {
    display: flex;
    justify-content: flex-start;
  }

  .agents-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-canopy-green);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .agents-link:hover {
    color: #124d30;
    text-decoration: underline;
  }

  .arrow {
    font-size: 15px;
  }
</style>
