---
// Authentic TAR Credit Pricing — 3 Horizontal Cards (Base Pack ₹0, Work Pack ₹500/mo, Top-Up Refill)
const packs = [
  {
    badge: "FREE TO START",
    name: "Base Pack",
    price: "₹0",
    wallet: "100% Free Forever",
    desc: "Offline sales, product catalog, inventory, and unlimited team members on your device."
  },
  {
    badge: "MONTHLY WORKSPACE",
    name: "Work Pack",
    price: "₹500 / mo",
    wallet: "Includes 1,000 cr / mo (₹100 wallet)",
    desc: "Unlocks encrypted cloud sync, WhatsApp messaging, and ₹100 monthly credit wallet."
  },
  {
    badge: "PAY AS YOU GO",
    name: "Top-Up Refill",
    price: "From ₹100",
    wallet: "100% wallet credit (1 cr = ₹0.10)",
    desc: "Refill on demand directly in the app. Pure at-cost pass-through, credits never expire."
  }
];
---

<section class="tar-pricing-section" id="pricing">
  <div class="container">
    
    <!-- Section Header -->
    <div class="section-head-left">
      <h2 class="display-section-lg section-title">
        Simple credit pricing.
      </h2>
      <p class="section-lead font-dm-sans">
        1 Credit = ₹0.10. Zero monthly seat licenses. Invited team members are always ₹0.
      </p>
    </div>

    <!-- 3 Horizontal Pack Cards in a Row -->
    <div class="packs-horizontal-grid font-dm-sans">
      {packs.map((p) => (
        <div class="pack-card">
          <div class="pack-card-top">
            <span class="pack-badge">{p.badge}</span>
            <h3 class="pack-name">{p.name}</h3>
          </div>
          
          <div class="pack-price-block">
            <div class="pack-price font-mono">{p.price}</div>
            <div class="pack-wallet-text">{p.wallet}</div>
          </div>

          <div class="pack-divider"></div>

          <p class="pack-desc">{p.desc}</p>
        </div>
      ))}
    </div>

    <!-- Bottom Reference Link -->
    <div class="pricing-bottom-bar font-dm-sans">
      <a href="/agents" class="agents-link">
        <span>View Detailed Agent & Model Rates</span>
        <span class="arrow">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .tar-pricing-section {
    background-color: #ffffff;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .section-head-left {
    max-width: 720px;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .section-lead {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-graphite);
    margin: 0;
  }

  /* 3 Horizontal Pack Cards Side-by-Side */
  .packs-horizontal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    margin-bottom: 24px;
  }

  @media (max-width: 580px) {
    .packs-horizontal-grid {
      grid-template-columns: 1fr;
    }
  }

  .pack-card {
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 14px;
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
  }

  .pack-card:hover {
    border-color: var(--color-canopy-green);
  }

  .pack-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pack-badge {
    font-size: 10px;
    font-weight: 700;
    color: var(--color-canopy-green);
    background-color: rgba(10, 57, 34, 0.06);
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pack-name {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-canopy-green);
    margin: 0;
  }

  .pack-price-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pack-price {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-canopy-green);
    line-height: 1;
  }

  .pack-wallet-text {
    font-size: 13px;
    font-weight: 600;
    color: #15803d;
  }

  .pack-divider {
    height: 1px;
    background-color: rgba(0, 0, 0, 0.06);
    width: 100%;
  }

  .pack-desc {
    font-size: 13.5px;
    color: var(--color-graphite);
    line-height: 1.5;
    margin: 0;
  }

  /* Bottom Link */
  .pricing-bottom-bar {
    display: flex;
    justify-content: flex-start;
  }

  .agents-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-canopy-green);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .agents-link:hover {
    color: #124d30;
    text-decoration: underline;
  }

  .arrow {
    font-size: 15px;
  }
</style>
