---
// Clean Editorial Stories — Turn.io Sage Wash Room (#e4f7ee)
const stories = [
  {
    quote: "We cut missed appointments by 38% simply by sending patients gentle WhatsApp reminders 24 hours before their visit. People can confirm with a single tap.",
    org: "Community Health Clinic",
    author: "Clinical Operations Lead",
    impact: "38% Fewer Missed Visits"
  },
  {
    quote: "Patients love sending voice notes in Tamil and Hindi to check if their medicines are ready. Our pharmacy staff spends far less time stuck on phone calls and much more time helping people face-to-face.",
    org: "Neighborhood Care Pharmacy",
    author: "Managing Pharmacist",
    impact: "3,000+ Voice Notes / Mo"
  },
  {
    quote: "During seasonal flooding, we broadcast real-time shelter updates and supply points to thousands of families on Telegram without spending thousands of dollars on software seat taxes.",
    org: "Civic Relief Network",
    author: "Emergency Response Coordinator",
    impact: "10,000+ Families Reached"
  }
];
---

<section class="stories-editorial-section pastel-room-sage reveal-item" id="stories">
  <div class="container">
    
    <div class="section-head-left">
      <h2 class="display-section-lg section-title">
        Real impact in real communities.
      </h2>
      <p class="section-lead font-dm-sans">
        See how clinics, community pharmacies, and local response teams use TAR to stay connected with the people they serve every day.
      </p>
    </div>

    <!-- 3 Stories Editorial Columns with Subtle Dividers -->
    <div class="stories-editorial-grid font-dm-sans">
      {stories.map((s) => (
        <div class="story-editorial-col">
          <span class="story-impact-badge">{s.impact}</span>
          <p class="story-quote-txt">“{s.quote}”</p>
          
          <div class="story-footer">
            <strong class="story-org">{s.org}</strong>
            <span class="story-author">{s.author}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .stories-editorial-section {
    padding: var(--section-gap) 0;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .section-head-left {
    max-width: 800px;
    margin-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .section-lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-graphite);
  }

  .stories-editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  @media (min-width: 768px) {
    .stories-editorial-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .story-editorial-col {
    padding: 32px 28px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    border-right: 1px solid rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    background-color: rgba(255, 255, 255, 0.35);
  }

  .story-impact-badge {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 700;
    color: var(--color-coral-pulse);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .story-quote-txt {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-graphite);
    flex: 1;
  }

  .story-footer {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-top: 14px;
  }

  .story-org {
    font-size: 14px;
    color: var(--color-canopy-green);
  }

  .story-author {
    font-size: 12px;
    color: var(--color-slate);
  }
</style>
