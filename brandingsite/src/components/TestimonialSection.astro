---
// Community Stories & Impact — Compact & Uncluttered
const stories = [
  {
    quote: "We cut missed appointments by 38% simply by sending patients gentle WhatsApp reminders 24 hours before their visit. People can confirm with a single tap.",
    org: "Community Health Clinic",
    author: "Clinical Operations Lead",
    impact: "38% Fewer Missed Visits"
  },
  {
    quote: "Patients love sending voice notes in Tamil to check if medicines are ready. Our staff spends far less time on phone calls and more time helping people face-to-face.",
    org: "Neighborhood Care Pharmacy",
    author: "Managing Pharmacist",
    impact: "3,000+ Voice Notes / Mo"
  },
  {
    quote: "During seasonal flooding, we broadcast real-time shelter updates to thousands of families on Telegram without spending thousands on software seat taxes.",
    org: "Civic Relief Network",
    author: "Emergency Response Coordinator",
    impact: "10,000+ Families Reached"
  }
];
---

<section class="stories-editorial-section pastel-room-sage" id="stories">
  <div class="container">
    
    <div class="section-head-left">
      <h2 class="display-section-lg section-title">
        Real impact in real communities.
      </h2>
      <p class="section-lead font-dm-sans">
        How clinics, pharmacies, and local response teams use TAR to stay connected with the people they serve.
      </p>
    </div>

    <!-- 3 Stories Editorial Columns -->
    <div class="stories-editorial-grid font-dm-sans">
      {stories.map((s) => (
        <div class="story-editorial-col">
          <span class="story-impact-badge">{s.impact}</span>
          <p class="story-quote-txt">“{s.quote}”</p>
          
          <div class="story-footer">
            <strong class="story-org">{s.org}</strong>
            <span class="story-author">{s.author}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .stories-editorial-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .section-head-left {
    max-width: 800px;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
  }

  .section-lead {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-graphite);
  }

  .stories-editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 768px) {
    .stories-editorial-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .story-editorial-col {
    padding: 24px 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    border-right: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    background-color: rgba(255, 255, 255, 0.35);
  }

  .story-impact-badge {
    align-self: flex-start;
    font-size: 10.5px;
    font-weight: 700;
    color: var(--color-canopy-green);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .story-quote-txt {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-graphite);
    flex: 1;
    margin: 0;
  }

  .story-footer {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    padding-top: 12px;
  }

  .story-org {
    font-size: 13.5px;
    color: var(--color-canopy-green);
  }

  .story-author {
    font-size: 11.5px;
    color: var(--color-slate);
  }
</style>
