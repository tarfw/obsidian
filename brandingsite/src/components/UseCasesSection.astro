---
// Reach Every Customer — New Plan: WhatsApp, Telegram, Messenger, Instagram DM, Email, On-site chat
const channelGroups = [
  {
    title: "Chat apps",
    chips: "WhatsApp · Telegram · Messenger · Instagram DM",
    desc: "Interactive booking buttons, catalog orders and PDF invoices on the apps customers open daily."
  },
  {
    title: "Email",
    chips: "Quotes · Invoices · Follow-ups",
    desc: "Templates, delivery tracking and replies in one feed — quotes and receipts that always arrive."
  },
  {
    title: "On-site chat",
    chips: "Website widget",
    desc: "Turn website visitors into conversations and conversations into orders — no third-party tools."
  }
];
---

<section class="channels-compare-section pastel-room-lilac" id="channels">
  <div class="container">

    <!-- Section Header -->
    <div class="section-head-left">
      <h2 class="display-section-lg section-title">
        Reach every customer on<br />
        their favorite channel.
      </h2>
      <p class="section-lead font-dm-sans">
        Customers can't be forced onto one app — so TAR supports many. Two-way conversations, tracked in one customer feed.
      </p>
    </div>

    <!-- 3 Clean Columns -->
    <div class="channels-compare-grid font-dm-sans">
      {channelGroups.map((c) => (
        <div class="channel-col">
          <h3 class="channel-title">{c.title}</h3>
          <p class="channel-chips">{c.chips}</p>
          <p class="channel-desc">{c.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .channels-compare-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .section-head-left {
    max-width: 680px;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .section-lead {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-graphite);
    margin: 0;
  }

  .channels-compare-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 768px) {
    .channels-compare-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .channel-col {
    padding: 24px 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (min-width: 768px) {
    .channel-col {
      border-bottom: none;
      border-right: 1px solid rgba(0, 0, 0, 0.08);
      padding: 28px 24px;
    }
    .channel-col:first-child {
      padding-left: 0;
    }
    .channel-col:last-child {
      border-right: none;
      padding-right: 0;
    }
  }

  .channel-title {
    font-size: 17.5px;
    font-weight: 700;
    color: var(--color-canopy-green);
    margin: 0;
  }

  .channel-chips {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-canopy-green);
    opacity: 0.75;
    margin: 0;
  }

  .channel-desc {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-graphite);
    margin: 0;
  }
</style>
