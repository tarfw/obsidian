---
// Multi-Channel Solutions — Ultra-Compact & Uncluttered
const channels = [
  {
    title: "WhatsApp Business",
    desc: "Interactive booking buttons, catalog orders, and PDF invoices on the app customers open daily."
  },
  {
    title: "SMS Global",
    desc: "Guaranteed OTP and urgent dispatch delivery to any basic mobile phone in 190+ countries."
  },
  {
    title: "Voice Notes",
    desc: "Speak naturally in Tamil, English, and 40+ languages. Whisper transcribes audio into records instantly."
  }
];
---

<section class="channels-compare-section pastel-room-lilac" id="channels">
  <div class="container">
    
    <!-- Section Header -->
    <div class="section-head-left">
      <h2 class="display-section-lg section-title">
        Reach every customer on<br />
        WhatsApp, SMS, or Voice.
      </h2>
      <p class="section-lead font-dm-sans">
        One unified customer feed. Choose the right channel for every interaction.
      </p>
    </div>

    <!-- 3 Clean Columns -->
    <div class="channels-compare-grid font-dm-sans">
      {channels.map((c, idx) => (
        <div class="channel-col">
          <span class="channel-num">{String(idx + 1).padStart(2, '0')}</span>
          <h3 class="channel-title">{c.title}</h3>
          <p class="channel-desc">{c.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .channels-compare-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
    box-sizing: border-box;
    color: var(--color-ink-black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .section-head-left {
    max-width: 680px;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-title {
    color: var(--color-canopy-green);
    line-height: 1.08;
  }

  .section-lead {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-graphite);
    margin: 0;
  }

  .channels-compare-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 768px) {
    .channels-compare-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .channel-col {
    padding: 24px 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (min-width: 768px) {
    .channel-col {
      border-bottom: none;
      border-right: 1px solid rgba(0, 0, 0, 0.08);
      padding: 28px 24px;
    }
    .channel-col:first-child {
      padding-left: 0;
    }
    .channel-col:last-child {
      border-right: none;
      padding-right: 0;
    }
  }

  .channel-num {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-slate);
    letter-spacing: 0.06em;
  }

  .channel-title {
    font-size: 17.5px;
    font-weight: 700;
    color: var(--color-canopy-green);
    margin: 0;
  }

  .channel-desc {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-graphite);
    margin: 0;
  }
</style>
