---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import HeroSection from "../components/HeroSection.astro";
import HowItWorksSection from "../components/HowItWorksSection.astro";
import ChannelPlayground from "../components/ChannelPlayground.astro";
import UseCasesSection from "../components/UseCasesSection.astro";
import BenefitsSection from "../components/BenefitsSection.astro";
import PricingSection from "../components/PricingSection.astro";
import TestimonialSection from "../components/TestimonialSection.astro";
import FaqSection from "../components/FaqSection.astro";
import CtaBanner from "../components/CtaBanner.astro";
import FooterSection from "../components/FooterSection.astro";
---

<Layout
  title="TAR — Helpful messaging on WhatsApp & SMS for clinics, businesses & communities"
  description="Automate appointment reminders, customer support, and helpful updates on WhatsApp, Telegram, SMS, and Voice. Simple to set up with zero monthly per-seat fees."
>
  <!-- Clean Header Navigation -->
  <Nav />

  <main class="page-body">
    <!-- Human-Focused Hero Section (Fits 100vh) -->
    <HeroSection />

    <!-- How It Works in 3 Simple Steps -->
    <HowItWorksSection />

    <!-- Channels Showcase: WhatsApp, Telegram, SMS, Voice -->
    <ChannelPlayground />

    <!-- Everyday Solutions for Clinics, Businesses & Schools -->
    <UseCasesSection />

    <!-- Core Benefits: Zero Seat Fees, 24/7 Replies, Voice Notes -->
    <BenefitsSection />

    <!-- Simple, Honest Pricing with Usage Slider -->
    <PricingSection />

    <!-- Community Stories & Impact -->
    <TestimonialSection />

    <!-- Plain-English Frequently Asked Questions -->
    <FaqSection />

    <!-- Pre-Footer Call to Action -->
    <CtaBanner />
  </main>

  <!-- Complete Directory Footer -->
  <FooterSection />
</Layout>

<style>
  .page-body {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
