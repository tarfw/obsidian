---
// Hungry Tiger — Fire-Roasted Condiments (Extended DESIGN.md Implementation)
const title = "Hungry Tiger — Bold Indian Sauces Made for Real Life";
const description = "Turmeric-bright graffiti on a tandoor wall. A single gold-on-rust palette with display type so large it reads as a spice market sign.";

const navLinks = [
  { label: "sauce", href: "#products" },
  { label: "about", href: "#about" },
  { label: "recipes", href: "#recipes" },
  { label: "game", href: "#game" },
  { label: "contact", href: "#contact" },
];

const products = [
  {
    id: "tikka-masala",
    title: "TIKKA MASALA SAUCE",
    subtitle: "SMOKY · FENUGREEK · ROASTED AROMATICS",
    description: "Our signature fire-roasted blend. Whole cumin toasted in tandoor kettles, simmered with vine-ripened tomatoes, sweet garlic, and fresh cream.",
    price: "$14.00",
    badge: "BESTSELLER",
    badgeType: "primary",
    image: "https://cdn.prod.website-files.com/683fa5578c4365b4bb69fade/684c4d869413e0e21067e360_Home.png",
  },
  {
    id: "vindaloo-fire",
    title: "VINDALOO FIRE DRIZZLE",
    subtitle: "KASHMIRI CHILI · PALM VINEGAR · ROASTED CLOVE",
    description: "A fierce Goan reduction packed with charred cloves, roasted cumin seeds, and aged cane vinegar. Intense warmth without artificial extracts.",
    price: "$16.00",
    badge: "EXTRA HOT",
    badgeType: "alert",
    image: "https://images.refero.design/styles/refero.design/image/4bb82077-2c47-41d2-ba95-3b719bf8bf7e.jpg",
  },
  {
    id: "saffron-cardamom",
    title: "SAFFRON CARDAMOM CHUTNEY",
    subtitle: "ALPHONSO MANGO · GREEN CARDAMOM · GINGER",
    description: "Sun-ripened mangoes slowly caramelized with hand-cracked cardamom pods and ground ginger root. The perfect sweet-heat companion.",
    price: "$15.00",
    badge: "LIMITED DROP",
    badgeType: "primary",
    image: "https://images.refero.design/styles/refero.design/image/4bb82077-2c47-41d2-ba95-3b719bf8bf7e.jpg",
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Antonio:wght@600;700&family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      /* Colors */
      --color-tiger-gold: #faae33;
      --color-ember-rust: #823513;
      --color-saffron-glow: #9f531b;
      --color-dark-spice: #402011;
      --color-charred-clove: #281006;
      --color-cardamom-brown: #6b2e12;
      --color-chili-red: #d1255c;

      /* Typography */
      --font-display: 'Antonio', 'Bebas Neue', sans-serif;
      --font-body: 'Inter', system-ui, sans-serif;

      /* Radii */
      --radius-card: 6px;
      --radius-pill: 9999px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      background-color: var(--color-ember-rust);
      color: var(--color-tiger-gold);
      font-family: var(--font-body);
      -webkit-font-smoothing: antialiased;
    }

    body {
      background-color: var(--color-ember-rust);
      min-height: 100vh;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* ── Announcement Top Ticker ────────────────────────── */
    .announcement-bar {
      background-color: var(--color-charred-clove);
      color: var(--color-tiger-gold);
      text-align: center;
      padding: 10px 16px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      border-bottom: 1px solid var(--color-cardamom-brown);
    }

    /* ── Header Navigation ──────────────────────────────── */
    .header-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background-color: rgba(130, 53, 19, 0.95);
      backdrop-filter: blur(12px);
      padding: 18px clamp(16px, 4vw, 40px);
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--color-cardamom-brown);
    }

    .nav-links {
      display: flex;
      gap: 12px;
    }

    .ghost-pill-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 8px 18px;
      border: 1px solid var(--color-tiger-gold);
      border-radius: var(--radius-pill);
      color: var(--color-tiger-gold);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: transparent;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .ghost-pill-btn:hover {
      background-color: rgba(250, 174, 51, 0.12);
      transform: translateY(-1px);
    }

    .logo-brand {
      font-family: var(--font-display);
      font-size: clamp(24px, 3.5vw, 36px);
      font-weight: 700;
      letter-spacing: -0.02em;
      text-transform: uppercase;
      color: var(--color-tiger-gold);
    }

    .filled-pill-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background-color: var(--color-tiger-gold);
      color: var(--color-charred-clove);
      padding: 10px 24px;
      border-radius: var(--radius-pill);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border: 1px solid var(--color-tiger-gold);
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .filled-pill-btn:hover {
      background-color: #f7a21b;
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    }

    /* ── Hero Poster Section ────────────────────────────── */
    .hero-section {
      position: relative;
      min-height: 90vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: clamp(40px, 8vw, 80px) clamp(16px, 4vw, 32px);
      background-color: var(--color-ember-rust);
      overflow: hidden;
    }

    /* Subtle Botanical Texture Background */
    .hero-section::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle at 50% 50%, rgba(159, 83, 27, 0.25) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-eyebrow {
      font-size: clamp(11px, 1.4vw, 13px);
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-tiger-gold);
      margin-bottom: clamp(12px, 2vw, 20px);
    }

    .hero-display-title {
      font-family: var(--font-display);
      font-size: clamp(64px, 16vw, 213px);
      font-weight: 700;
      line-height: 0.80;
      letter-spacing: -0.025em;
      color: var(--color-tiger-gold);
      text-transform: uppercase;
      margin-bottom: clamp(8px, 1.5vw, 16px);
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .hero-subtitle {
      font-family: var(--font-display);
      font-size: clamp(24px, 4.5vw, 56px);
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-tiger-gold);
      margin-bottom: clamp(24px, 4vw, 40px);
      opacity: 0.95;
    }

    .hero-jar-container {
      position: relative;
      max-width: 380px;
      width: 100%;
      margin: 0 auto clamp(24px, 4vw, 40px);
      z-index: 10;
    }

    .hero-jar-img {
      width: 100%;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 20px 40px rgba(40, 16, 6, 0.6));
      transition: transform 0.4s ease;
    }

    .hero-jar-container:hover .hero-jar-img {
      transform: scale(1.03) rotate(-1deg);
    }

    /* Left Highlight Note */
    .hero-side-card {
      position: absolute;
      left: clamp(16px, 4vw, 48px);
      bottom: clamp(24px, 5vw, 60px);
      max-width: 260px;
      text-align: left;
      z-index: 20;
    }

    .hero-side-text {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1.4;
      color: var(--color-tiger-gold);
      margin-bottom: 12px;
      opacity: 0.9;
    }

    /* ── Dotted Divider ─────────────────────────────────── */
    .dotted-divider {
      width: 100%;
      border-bottom: 1px dotted var(--color-tiger-gold);
      opacity: 0.85;
    }

    /* ── Product Catalog Section ────────────────────────── */
    .catalog-section {
      padding: clamp(60px, 8vw, 100px) clamp(16px, 4vw, 48px);
      max-width: 1440px;
      margin: 0 auto;
      width: 100%;
    }

    .section-header {
      text-align: center;
      margin-bottom: clamp(40px, 6vw, 64px);
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(36px, 6vw, 80px);
      font-weight: 700;
      line-height: 0.9;
      letter-spacing: -0.015em;
      text-transform: uppercase;
      color: var(--color-tiger-gold);
      margin-bottom: 14px;
    }

    .section-subtitle {
      font-size: clamp(13px, 1.5vw, 16px);
      font-weight: 500;
      color: var(--color-saffron-glow);
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.5;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
      gap: 24px;
    }

    .product-card {
      background-color: var(--color-dark-spice);
      border: 1px solid var(--color-cardamom-brown);
      border-radius: var(--radius-card);
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.3s ease, border-color 0.3s ease;
      position: relative;
    }

    .product-card:hover {
      transform: translateY(-4px);
      border-color: var(--color-tiger-gold);
    }

    .badge-pill {
      display: inline-block;
      padding: 4px 12px;
      border-radius: var(--radius-pill);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      align-self: flex-start;
      margin-bottom: 16px;
    }

    .badge-primary {
      background-color: var(--color-tiger-gold);
      color: var(--color-charred-clove);
    }

    .badge-alert {
      background-color: var(--color-chili-red);
      color: #ffffff;
    }

    .card-img-wrap {
      width: 100%;
      aspect-ratio: 4/5;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }

    .card-img-wrap img {
      max-height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.4));
      transition: transform 0.3s ease;
    }

    .product-card:hover .card-img-wrap img {
      transform: scale(1.05);
    }

    .product-info h3 {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 700;
      color: var(--color-tiger-gold);
      margin-bottom: 4px;
      letter-spacing: -0.01em;
    }

    .product-info .sub {
      font-size: 11px;
      font-weight: 700;
      color: var(--color-saffron-glow);
      letter-spacing: 0.1em;
      margin-bottom: 12px;
    }

    .product-info p {
      font-size: 13px;
      line-height: 1.5;
      color: var(--color-tiger-gold);
      opacity: 0.85;
      margin-bottom: 20px;
    }

    .card-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 16px;
      border-top: 1px solid var(--color-cardamom-brown);
    }

    .card-price {
      font-family: var(--font-display);
      font-size: 24px;
      font-weight: 700;
      color: var(--color-tiger-gold);
    }

    /* ── Story / Manifesto Section ──────────────────────── */
    .story-section {
      background-color: var(--color-dark-spice);
      border-top: 1px solid var(--color-cardamom-brown);
      border-bottom: 1px solid var(--color-cardamom-brown);
      padding: clamp(60px, 8vw, 100px) clamp(16px, 4vw, 48px);
    }

    .story-container {
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
      gap: clamp(32px, 6vw, 64px);
      align-items: center;
    }

    .story-content h2 {
      font-family: var(--font-display);
      font-size: clamp(36px, 5vw, 64px);
      line-height: 0.95;
      color: var(--color-tiger-gold);
      margin-bottom: 20px;
      letter-spacing: -0.01em;
    }

    .story-content p {
      font-size: 15px;
      line-height: 1.6;
      color: var(--color-tiger-gold);
      opacity: 0.9;
      margin-bottom: 28px;
    }

    .highlights-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .highlights-list li {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      font-weight: 600;
      color: var(--color-tiger-gold);
    }

    .check-dot {
      width: 22px;
      height: 22px;
      background-color: var(--color-tiger-gold);
      color: var(--color-charred-clove);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 11px;
      flex-shrink: 0;
    }

    .story-img-wrap {
      border-radius: var(--radius-card);
      overflow: hidden;
      border: 1px solid var(--color-cardamom-brown);
    }

    .story-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ── Footer ─────────────────────────────────────────── */
    .footer {
      background-color: var(--color-charred-clove);
      padding: clamp(40px, 6vw, 64px) clamp(16px, 4vw, 48px);
      border-top: 1px solid var(--color-cardamom-brown);
    }

    .footer-inner {
      max-width: 1440px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 24px;
    }

    .footer-brand {
      font-family: var(--font-display);
      font-size: 24px;
      font-weight: 700;
      color: var(--color-tiger-gold);
    }

    .footer-links {
      display: flex;
      gap: 20px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-saffron-glow);
    }

    .footer-links a:hover {
      color: var(--color-tiger-gold);
    }

    /* ── Responsive Rules ───────────────────────────────── */
    @media (max-width: 768px) {
      .header-nav {
        flex-direction: column;
        gap: 16px;
      }
      .nav-links {
        flex-wrap: wrap;
        justify-content: center;
      }
      .hero-side-card {
        position: static;
        margin-top: 24px;
        text-align: center;
        max-width: 100%;
      }
    }
  </style>
</head>
<body>
  <!-- 1. Announcement Bar -->
  <div class="announcement-bar">
    FIRE ROASTED CONDIMENTS · FREE SHIPPING ON ORDERS OVER $45 · DROP 04 LIVE NOW
  </div>

  <!-- 2. Header Nav -->
  <header class="header-nav">
    <div class="nav-links">
      {navLinks.map((link) => (
        <a href={link.href} class="ghost-pill-btn">{link.label}</a>
      ))}
    </div>

    <a href="/" class="logo-brand">HUNGRY TIGER</a>

    <a href="#cart" class="filled-pill-btn">BUY NOW</a>
  </header>

  <!-- 3. Poster Hero Section -->
  <section class="hero-section">
    <div class="hero-eyebrow">FIRE ROASTED INDIAN SPICES</div>
    <h1 class="hero-display-title">BOLD FLAVOR</h1>
    <div class="hero-subtitle">TIKKA MASALA</div>

    <div class="hero-jar-container">
      <img
        src="https://cdn.prod.website-files.com/683fa5578c4365b4bb69fade/684c4d869413e0e21067e360_Home.png"
        alt="Hungry Tiger Tikka Masala Jar"
        class="hero-jar-img"
      />
    </div>

    <div style="display: flex; gap: 16px; justify-content: center; z-index: 20;">
      <a href="#products" class="filled-pill-btn">BUY NOW</a>
      <a href="#about" class="ghost-pill-btn">OUR STORY ›</a>
    </div>

    <!-- Side Highlight Note -->
    <div class="hero-side-card">
      <div class="hero-side-text">
        BOLD FLAVORS FROM THE KITCHENS OF INDIA. CRAFTED FOR THOSE WHO CRAVE MORE.
      </div>
      <a href="#products" class="filled-pill-btn" style="padding: 6px 16px; font-size: 10px;">BUY NOW</a>
    </div>
  </section>

  <!-- 4. Dotted Section Divider -->
  <div class="dotted-divider"></div>

  <!-- 5. Product Lineup Catalog -->
  <section id="products" class="catalog-section">
    <div class="section-header">
      <h2 class="section-title">A NEW ANGLE OF FLAVOR</h2>
      <p class="section-subtitle">
        Packed with whole toasted pods, crushed mustard seeds, and pure tandoor character. No gums, no fillers, no shortcuts.
      </p>
    </div>

    <div class="product-grid">
      {products.map((item) => (
        <div class="product-card">
          <div>
            <span class={`badge-pill ${item.badgeType === 'alert' ? 'badge-alert' : 'badge-primary'}`}>
              {item.badge}
            </span>
            <div class="card-img-wrap">
              <img src={item.image} alt={item.title} />
            </div>
            <div class="product-info">
              <h3>{item.title}</h3>
              <div class="sub">{item.subtitle}</div>
              <p>{item.description}</p>
            </div>
          </div>

          <div class="card-bottom">
            <span class="card-price">{item.price}</span>
            <a href="#order" class="filled-pill-btn" style="padding: 8px 18px; font-size: 11px;">
              ADD TO CART
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 6. Dotted Section Divider -->
  <div class="dotted-divider"></div>

  <!-- 7. Brand Story / Tandoor Manifesto -->
  <section id="about" class="story-section">
    <div class="story-container">
      <div class="story-content">
        <h2>ANCIENT SPICE.<br />MODERN FIRE.</h2>
        <p>
          Hungry Tiger is born from a refusal of bland, watery supermarket sauces. We roast our spices in cast iron, crack whole black cardamoms, and simmer in small kettles to capture the unapologetic intensity of Indian street stalls.
        </p>
        <ul class="highlights-list">
          <li>
            <span class="check-dot">✓</span>
            100% Single-Origin Indian Spices & Cold-Pressed Mustard Oil
          </li>
          <li>
            <span class="check-dot">✓</span>
            Zero Cane Sugar, Artificial Gums, or Preservatives
          </li>
          <li>
            <span class="check-dot">✓</span>
            Slow Kettle-Simmered for True Caramelized Depth
          </li>
        </ul>
      </div>

      <div class="story-img-wrap">
        <img
          src="https://images.unsplash.com/photo-1596040033229-a9821ebd058d?w=800&h=800&fit=crop"
          alt="Fire Roasted Spices"
        />
      </div>
    </div>
  </section>

  <!-- 8. Footer Strip -->
  <footer class="footer">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">HUNGRY TIGER</div>
        <p style="font-size: 12px; color: var(--color-saffron-glow); margin-top: 4px;">
          © 2026 Hungry Tiger Inc. All Rights Reserved.
        </p>
      </div>

      <div class="footer-links">
        <a href="#privacy">Privacy</a>
        <a href="#terms">Terms</a>
        <a href="#wholesale">Wholesale</a>
        <a href="#contact">Contact</a>
      </div>
    </div>
  </footer>
</body>
</html>
