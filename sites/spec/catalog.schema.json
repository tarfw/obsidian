{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tar.app/schemas/catalog.schema.json",
  "title": "TAR Site Component Catalog",
  "description": "A reviewed catalog of site components. Every prop value must reference a design token; components bind to registered queries, Actions and Flows, never arbitrary code.",
  "type": "object",
  "required": ["version", "components"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "name": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["name", "category", "props"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string" },
        "category": {
          "enum": [
            "Navigation",
            "Hero",
            "Content",
            "Collection",
            "Features",
            "Proof",
            "FAQ",
            "Hours",
            "Contact",
            "Form",
            "CTA",
            "Footer",
            "Commerce",
            "Booking",
            "Utility",
            "Escape"
          ]
        },
        "description": { "type": "string" },
        "props": {
          "type": "array",
          "items": { "$ref": "#/$defs/prop" }
        },
        "variants": {
          "type": "array",
          "items": { "type": "string" }
        },
        "slots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/tokenRef" }
        },
        "responsive": {
          "type": "object",
          "additionalProperties": true
        },
        "a11y": { "$ref": "#/$defs/a11y" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionRef" }
        },
        "binds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "prop": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "type": {
          "enum": ["text", "rich", "number", "boolean", "media", "record", "list", "token", "action"]
        },
        "required": { "type": "boolean" },
        "token": { "$ref": "#/$defs/tokenRef" },
        "enum": {
          "type": "array",
          "items": { "type": "string" }
        },
        "default": {},
        "description": { "type": "string" }
      }
    },
    "tokenRef": {
      "type": "string",
      "pattern": "^\\{[a-zA-Z0-9._-]+\\}$"
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headingLevel": { "type": "integer", "minimum": 1, "maximum": 6 },
        "contrast": { "enum": ["AA", "AAA"] },
        "focusOrder": {
          "type": "array",
          "items": { "type": "string" }
        },
        "landmarks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "actionRef": {
      "type": "object",
      "required": ["slot", "target"],
      "additionalProperties": false,
      "properties": {
        "slot": { "type": "string" },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$"
        }
      }
    }
  }
}
