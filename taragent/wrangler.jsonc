{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taragent",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "54dc15bf1f8fecfd12dac7b74149eb9a",
  "workers_dev": true,
  "routes": [],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tar",
      "database_id": "977e76b3-b14d-4969-a854-8958e2f88cfa"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STOREFRONT_CACHE",
      "id": "9fcfbb6bc68542e7a6a3762dd61c6c10"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tar-storage"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "GROQ_API_KEY": "${GROQ_API_KEY}",
    "TURSO_DATABASE_URL": "${TURSO_DATABASE_URL}",
    "TURSO_AUTH_TOKEN": "${TURSO_AUTH_TOKEN}",
    "TURSO_PLATFORM_TOKEN": "${TURSO_PLATFORM_TOKEN}",
    "TURSO_GROUP_TOKEN": "${TURSO_GROUP_TOKEN}",
    "RAILWAY_S3_ENDPOINT": "${RAILWAY_S3_ENDPOINT}",
    "RAILWAY_S3_BUCKET": "${RAILWAY_S3_BUCKET}",
    "RAILWAY_S3_ACCESS_KEY": "${RAILWAY_S3_ACCESS_KEY}",
    "RAILWAY_S3_SECRET_KEY": "${RAILWAY_S3_SECRET_KEY}"
  }
}
