# Turso database-per-user/workspace provisioning
TURSO_ORG=your-turso-organization
TURSO_PLATFORM_TOKEN=your-platform-api-token
TURSO_AUTH_TOKEN=your-private-group-database-token
TURSO_GROUP_APAC=default
TURSO_GROUP_EU=default
TURSO_GROUP_US=default

# Tar credit checkout and verified settlement
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Model Provider (for bounded synthesis & classification)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Channel Secrets
WHATSAPP_WEBHOOK_SECRET=your-whatsapp-secret
WHATSAPP_API_TOKEN=your-whatsapp-token

# OIDC authentication
OIDC_ISSUER=https://your-identity-provider.example.com/
OIDC_AUDIENCE=tarai
OIDC_JWKS_URL=https://your-identity-provider.example.com/.well-known/jwks.json

# WhatsApp tenant/provider mapping
WHATSAPP_WORKSPACE_ID=your-workspace-id
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
