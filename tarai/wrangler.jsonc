{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tarai",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-26",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"OIDC_ISSUER": "https://accounts.google.com,accounts.google.com",
		"OIDC_AUDIENCE": "226183831843-5sjvl1hsv4d04aucnqsqn19u83o4f5ku.apps.googleusercontent.com",
		"OIDC_JWKS_URL": "https://www.googleapis.com/oauth2/v3/certs",
		"TURSO_ORG": "tarapp",
		"TURSO_GROUP_APAC": "default",
		"TURSO_GROUP_EU": "default",
		"TURSO_GROUP_US": "default"
	},
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	},
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "TARAI_KV",
			"id": "fab1f25c70364787a9261056cdc935f8"
		}
	],
	"d1_databases": [
		{
			"binding": "CONTROL",
			"database_name": "control",
			"database_id": "823a3c59-4399-4da6-9cf3-d488818b6f2b",
			"migrations_dir": "d1/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "OKF_STORAGE",
			"bucket_name": "tarai-okf-storage"
		}
	],
	"workflows": [
		{
			"name": "tarai-agent",
			"binding": "AGENT_WORKFLOW",
			"class_name": "AgentWorkflow"
		},
		{
			"name": "tarai-projection",
			"binding": "PROJECTION_WORKFLOW",
			"class_name": "ProjectionWorkflow"
		},
		{
			"name": "tarai-archive",
			"binding": "ARCHIVE_WORKFLOW",
			"class_name": "ArchiveWorkflow"
		},
		{
			"name": "tarai-restore",
			"binding": "RESTORE_WORKFLOW",
			"class_name": "RestoreWorkflow"
		},
		{
			"name": "tarai-renewal",
			"binding": "RENEWAL_WORKFLOW",
			"class_name": "RenewalWorkflow"
		},
		{
			"name": "tarai-provision",
			"binding": "PROVISION_WORKFLOW",
			"class_name": "ProvisionWorkflow"
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	}
}
